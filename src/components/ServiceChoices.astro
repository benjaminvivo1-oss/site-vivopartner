---
/**
 * Services à cocher (plusieurs choix possibles) des formulaires généraux : accueil et /contact/.
 * Envoyés sous le nom `service` (src/scripts/contact.ts les réunit : « Aplomb, Réceptionniste IA »).
 * Styles : .vp-svc dans src/styles/base.css.
 */
import { SERVICE_OPTIONS } from '../data/services';
---

<fieldset class="vp-svc" data-bind="if:formOpen">
  <legend>
    Les services qui vous intéressent <span style="font-weight: 500; color: #5B6B8F">(facultatif)</span>
  </legend>
  <div>
    {SERVICE_OPTIONS.map((o) => (
      <label>
        <input type="checkbox" name="service" value={o} />
        <span>{o}</span>
      </label>
    ))}
  </div>
</fieldset>
