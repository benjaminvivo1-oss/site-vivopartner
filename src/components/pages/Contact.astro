---
/** Page Contact (maquette PageContact) : formulaire général. */
import ContactSection from '../ContactSection.astro';
---

<section style="font-family: Inter, system-ui, sans-serif; box-sizing: border-box; padding: 96px clamp(20px, 4vw, 48px) 104px; color: #ffffff; background: linear-gradient(180deg, #0A2F6E 0%, #06255A 55%, #051F4C 100%)">
  <div style="max-width: 1200px; margin: 0 auto; display: flex; flex-direction: column; gap: 24px; align-items: flex-start">
    <span style="font-family: 'JetBrains Mono', monospace; font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; color: #F58220; border: 1px solid #F58220; border-radius: 999px; padding: 8px 16px">Contact</span>
    <h1 style="font-family: Satoshi,Inter,sans-serif; margin: 0; font-size: clamp(36px, 5.4vw, 64px); line-height: 1.08; font-weight: 800; letter-spacing: -0.02em; max-width: 900px">Parlons de <span style="color: #F58220">votre entreprise</span>.</h1>
    <p style="margin: 0; font-size: 20px; line-height: 1.6; color: #D5DEF2; max-width: 680px">Un appel, un mail ou un formulaire : vous choisissez, je vous réponds sous 24h.</p>
  </div>
</section>
<ContactSection />
