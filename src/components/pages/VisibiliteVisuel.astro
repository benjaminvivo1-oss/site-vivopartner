---
/**
 * Visuel du haut de /visibilite-locale/ : une recherche locale où l'entreprise sort en premier
 * (fiche, carte, site, appel entrant). Dessiné en HTML/CSS, comme les visuels d'Aplomb et de la
 * réceptionniste. Contenu d'exemple, signalé comme tel.
 */
const pins = [
  { x: 22, y: 64, main: false },
  { x: 74, y: 30, main: false },
  { x: 46, y: 46, main: true },
];
---

<div class="vz" role="img" aria-label="Exemple : une entreprise du BTP qui sort en premier dans une recherche locale, avec sa fiche, son site et un appel entrant">
  <div class="vz-frame" aria-hidden="true">
    <div class="vz-screen">
      <div class="vz-bar">
        <span class="vz-dots"><i></i><i></i><i></i></span>
        <span class="vz-url">recherche · plombier carcassonne</span>
      </div>
      <div class="vz-search">
        <span class="vz-input">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"
            ><circle cx="11" cy="11" r="6.5"></circle><path d="M16 16l4.5 4.5"></path></svg
          >
          plombier carcassonne
        </span>
        <span class="vz-tabs"><b>Tous</b><span>Maps</span><span>Images</span></span>
      </div>
      <div class="vz-body">
        <div class="vz-map">
          <span class="vz-road r1"></span><span class="vz-road r2"></span><span class="vz-road r3"></span>
          <span class="vz-river"></span>
          {
            pins.map((p) => (
              <span class:list={['vz-pin', { main: p.main }]} style={`left:${p.x}%;top:${p.y}%`}>
                {p.main && <b>1</b>}
              </span>
            ))
          }
        </div>
        <div class="vz-list">
          <div class="vz-item first">
            <span class="vz-badge">En premier</span>
            <b class="vz-name">Dupont Plomberie</b>
            <span class="vz-stars"><span>★★★★★</span> 4,9 · Plombier · Carcassonne</span>
            <span class="vz-open">Ouvert · Intervient sur Carcassonne et alentours</span>
            <span class="vz-actions"><span class="call">Appeler</span><span>Site web</span><span>Itinéraire</span></span>
          </div>
          <div class="vz-item"><i class="w60"></i><i class="w80"></i><i class="w40"></i></div>
          <div class="vz-item"><i class="w50"></i><i class="w70"></i><i class="w30"></i></div>
        </div>
      </div>
    </div>
  </div>
  <div class="vz-toast vz-t1" aria-hidden="true">
    <span class="vz-ico call"
      ><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"
        ><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"></path></svg
      ></span
    >
    <span><b>Appel entrant</b><small>depuis votre fiche Google</small></span>
  </div>
  <div class="vz-toast vz-t2" aria-hidden="true">
    <span class="vz-ico ok"
      ><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"
        ><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg
      ></span
    >
    <span><b>Fiche Google à jour</b><small>horaires, photos, avis</small></span>
  </div>
  <span class="vz-note" aria-hidden="true">Résultat d’exemple</span>
</div>

<style>
  .vz {
    position: relative;
    width: 100%;
    max-width: 640px;
    margin: 0 auto;
    padding: 34px 0 30px;
    container-type: inline-size;
    color: #06255a;
    font-family: Inter, system-ui, sans-serif;
  }
  .vz-frame {
    padding: 12px;
    border-radius: 24px;
    background: linear-gradient(160deg, #2a3245, #0c1220);
    box-shadow:
      0 40px 80px rgba(0, 0, 0, 0.45),
      0 0 0 2px #3a4357,
      0 0 110px rgba(245, 130, 32, 0.14);
    transform: perspective(1800px) rotateY(-7deg) rotateX(2deg);
  }
  .vz-screen {
    border-radius: 13px;
    overflow: hidden;
    background: #f5f7fc;
  }
  .vz-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 9px 12px;
    background: #e6eaf2;
  }
  .vz-dots {
    display: flex;
    gap: 5px;
  }
  .vz-dots i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #b9c3d8;
  }
  .vz-url {
    flex: 1;
    min-width: 0;
    padding: 5px 12px;
    border-radius: 999px;
    background: #fff;
    font-size: 11px;
    color: #5b6b8f;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .vz-search {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
    padding: 14px 16px 10px;
    background: #fff;
    border-bottom: 1px solid #e1e6f5;
  }
  .vz-input {
    flex: 1 1 220px;
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 9px 14px;
    border-radius: 999px;
    border: 1px solid #dce3f0;
    box-shadow: 0 2px 8px rgba(6, 37, 90, 0.06);
    font-size: 14px;
    font-weight: 600;
    color: #06255a;
  }
  .vz-input svg {
    color: #5b6b8f;
    flex: none;
  }
  .vz-tabs {
    display: flex;
    gap: 14px;
    font-size: 12px;
    color: #5b6b8f;
  }
  .vz-tabs b {
    color: #06255a;
    border-bottom: 2px solid #f58220;
    padding-bottom: 3px;
  }
  .vz-body {
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: 12px;
    padding: 12px;
  }
  .vz-map {
    position: relative;
    min-height: 210px;
    border-radius: 12px;
    overflow: hidden;
    background: #e3eaf3;
  }
  .vz-road {
    position: absolute;
    background: #fff;
    border-radius: 4px;
  }
  .vz-road.r1 {
    left: -10%;
    top: 38%;
    width: 120%;
    height: 7px;
    transform: rotate(-8deg);
  }
  .vz-road.r2 {
    left: 52%;
    top: -10%;
    width: 7px;
    height: 120%;
    transform: rotate(12deg);
  }
  .vz-road.r3 {
    left: -10%;
    top: 74%;
    width: 120%;
    height: 5px;
    transform: rotate(6deg);
  }
  .vz-river {
    position: absolute;
    left: -10%;
    bottom: 6%;
    width: 60%;
    height: 14px;
    border-radius: 10px;
    background: #bcd3ef;
    transform: rotate(-14deg);
  }
  .vz-pin {
    position: absolute;
    width: 16px;
    height: 16px;
    margin: -16px 0 0 -8px;
    border-radius: 50% 50% 50% 0;
    background: #94a3b8;
    transform: rotate(-45deg);
  }
  .vz-pin.main {
    width: 30px;
    height: 30px;
    margin: -30px 0 0 -15px;
    background: #f58220;
    box-shadow: 0 6px 14px rgba(245, 130, 32, 0.45);
    color: #06255a;
    font-size: 13px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    animation: vzDrop 0.9s 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .vz-pin b {
    transform: rotate(45deg);
  }
  .vz-pin.main::before {
    content: '';
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 2px solid rgba(245, 130, 32, 0.6);
    animation: vzRing 2.4s 1.4s ease-out infinite;
  }
  .vz-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .vz-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 10px 12px;
    border-radius: 12px;
    background: #fff;
    border: 1px solid #e1e6f5;
  }
  .vz-item i {
    display: block;
    height: 7px;
    border-radius: 4px;
    background: #e3e9f4;
  }
  .vz-item .w30 {
    width: 30%;
  }
  .vz-item .w40 {
    width: 40%;
  }
  .vz-item .w50 {
    width: 50%;
  }
  .vz-item .w60 {
    width: 60%;
  }
  .vz-item .w70 {
    width: 70%;
  }
  .vz-item .w80 {
    width: 80%;
  }
  .vz-item.first {
    position: relative;
    gap: 3px;
    border: 2px solid #f58220;
    box-shadow: 0 10px 24px rgba(245, 130, 32, 0.18);
    animation: vzRise 0.9s 0.25s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .vz-badge {
    position: absolute;
    top: -10px;
    right: 10px;
    padding: 3px 9px;
    border-radius: 999px;
    background: #f58220;
    color: #06255a;
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .vz-name {
    font-family: Satoshi, Inter, sans-serif;
    font-size: 16px;
  }
  .vz-stars {
    font-size: 11.5px;
    color: #3e4f73;
  }
  .vz-stars span {
    color: #f5a623;
    letter-spacing: 1px;
  }
  .vz-open {
    font-size: 11px;
    color: #1e6b3e;
  }
  .vz-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 6px;
  }
  .vz-actions span {
    padding: 5px 10px;
    border-radius: 999px;
    border: 1px solid #dce3f0;
    font-size: 11px;
    font-weight: 700;
  }
  .vz-actions .call {
    background: #06255a;
    border-color: #06255a;
    color: #fff;
  }
  .vz-toast {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 14px;
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 20px 44px rgba(0, 0, 0, 0.38);
    font-size: 13px;
    line-height: 1.25;
  }
  .vz-toast b {
    display: block;
  }
  .vz-toast small {
    display: block;
    font-size: 11px;
    color: #5b6b8f;
  }
  .vz-toast.vz-t1 {
    right: -10px;
    top: 0;
    animation:
      vzRise 0.8s 1.1s cubic-bezier(0.16, 1, 0.3, 1) both,
      vzFloat 6s 2s ease-in-out infinite;
  }
  .vz-toast.vz-t2 {
    left: -14px;
    bottom: 6px;
    animation:
      vzRise 0.8s 1.5s cubic-bezier(0.16, 1, 0.3, 1) both,
      vzFloat 6s 3s ease-in-out infinite;
  }
  .vz-ico {
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .vz-ico.call {
    background: #e8f5ec;
    color: #1e6b3e;
  }
  .vz-ico.ok {
    background: #fff1e3;
    color: #b45309;
  }
  .vz-note {
    position: absolute;
    right: 8px;
    bottom: 4px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #94a3b8;
  }
  @keyframes vzRise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes vzFloat {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -8px;
    }
  }
  @keyframes vzDrop {
    from {
      opacity: 0;
      translate: 0 -26px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
  @keyframes vzRing {
    from {
      opacity: 0.9;
      transform: scale(0.6);
    }
    to {
      opacity: 0;
      transform: scale(1.6);
    }
  }
  /* Petits écrans : la carte passe au-dessus de la liste */
  @container (max-width: 480px) {
    .vz-body {
      grid-template-columns: 1fr;
    }
    .vz-map {
      min-height: 130px;
    }
    .vz-frame {
      transform: none;
    }
    .vz-toast {
      padding: 9px 11px;
      font-size: 12px;
    }
    .vz-toast.vz-t1 {
      right: -4px;
    }
    .vz-toast.vz-t2 {
      left: -4px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .vz *,
    .vz *::before {
      animation: none !important;
    }
  }
</style>
