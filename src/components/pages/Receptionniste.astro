            <span style="position: absolute; left: -3px; top: 92px; width: 4px; height: 26px; border-radius: 2px 0 0 2px; background: linear-gradient(90deg, #8E97A3, #C9CED6)"></span>
            <span style="position: absolute; left: -3px; top: 148px; width: 4px; height: 52px; border-radius: 2px 0 0 2px; background: linear-gradient(90deg, #8E97A3, #C9CED6)"></span>
            <span style="position: absolute; left: -3px; top: 212px; width: 4px; height: 52px; border-radius: 2px 0 0 2px; background: linear-gradient(90deg, #8E97A3, #C9CED6)"></span>
            <span style="position: absolute; right: -3px; top: 176px; width: 4px; height: 82px; border-radius: 0 2px 2px 0; background: linear-gradient(270deg, #8E97A3, #C9CED6)"></span>
            <div style="box-sizing: border-box; width: 100%; height: 100%; border-radius: 52px; padding: 3px; background: linear-gradient(145deg, #E7EAEE, #8B94A1 35%, #D6DADF 60%, #7C8591); box-shadow: 0 34px 64px rgba(0,0,0,0.5), inset 0 0 0 1px rgba(255,255,255,0.35)">
