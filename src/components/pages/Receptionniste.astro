                      </svg>
                      <svg width="16" height="12" viewBox="0 0 24 18" fill="none" stroke="#0A0F1E" stroke-width="2.6" stroke-linecap="round" aria-hidden="true">
                        <path d="M2 6.5a14 14 0 0 1 20 0M6 11a8 8 0 0 1 12 0" />
                        <circle cx="12" cy="15.5" r="1.6" fill="#0A0F1E" stroke="none" />
                      </svg>
                      <svg width="26" height="12" viewBox="0 0 26 12" aria-hidden="true">
                        <rect x="0.5" y="0.5" width="22" height="11" rx="3.5" fill="none" stroke="#0A0F1E" opacity="0.45" />
