                  <div style="align-self: flex-start; box-sizing: border-box; display: flex; align-items: center; gap: 10px; padding: 12px 16px; border-radius: 18px 18px 18px 6px; background: #06255A">
                    <span style="flex: none; width: 26px; height: 26px; border-radius: 50%; background: #F58220; display: flex; align-items: center; justify-content: center">
