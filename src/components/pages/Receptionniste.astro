---
import ContactSection from '../ContactSection.astro';
---

<section id="accueil-receptionniste" style="font-family: Inter, system-ui, sans-serif; box-sizing: border-box; padding: 104px clamp(20px, 4vw, 48px); color: #ffffff; background: linear-gradient(180deg, #0A2F6E 0%, #06255A 55%, #051F4C 100%)">
  <div style="max-width: 1200px; margin: 0 auto; display: flex; flex-direction: column; gap: 56px">
    <div style="display: flex; flex-wrap: wrap; gap: 48px 64px; align-items: center">
      <div style="flex: 1 1 440px; min-width: 0; display: flex; flex-direction: column; gap: 26px; align-items: flex-start">
        <span style="font-family: 'JetBrains Mono', monospace; font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; color: #F58220; border: 1px solid #F58220; border-radius: 999px; padding: 8px 16px">Levier 02 · Ne plus rien rater</span>
        <h1 style="font-family: Satoshi,Inter,sans-serif; margin: 0; font-size: clamp(34px, 5.2vw, 60px); line-height: 1.08; font-weight: 800; letter-spacing: -0.02em">Plus <span style="color: #F58220">aucun appel</span> perdu, même sur un chantier.</h1>
        <p style="margin: 0; font-size: 20px; line-height: 1.6; color: #C3D0EA; max-width: 560px">Une réceptionniste virtuelle décroche à votre place, pose les bonnes questions et vous envoie un résumé clair sur votre téléphone.</p>
