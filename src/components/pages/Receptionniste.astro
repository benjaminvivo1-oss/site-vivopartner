                  <span style="width: 48px; height: 48px; border-radius: 50%; background: #F3F6FC; display: flex; align-items: center; justify-content: center">
                    <svg width="34" height="34" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <rect x="5" y="7" width="14" height="11" rx="5" fill="#06255A" />
                      <rect x="3" y="11" width="2.5" height="4" rx="1" fill="#F58220" />
                      <rect x="18.5" y="11" width="2.5" height="4" rx="1" fill="#F58220" />
                      <circle cx="9.5" cy="12" r="1.3" fill="#ffffff" />
                      <circle cx="14.5" cy="12" r="1.3" fill="#ffffff" />
                      <path d="M12 7V4.5" stroke="#F58220" stroke-width="1.6" stroke-linecap="round" />
                      <circle cx="12" cy="4" r="1.3" fill="#F58220" />
