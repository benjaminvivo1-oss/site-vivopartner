</section>
<div id="facture-electronique" style="font-family: Inter, system-ui, sans-serif; box-sizing: border-box; padding: 22px clamp(20px, 4vw, 48px); color: #ffffff; background: #06255A; border-top: 1px solid rgba(255,255,255,0.12)">
  <div style="max-width: 1200px; margin: 0 auto; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px 32px">
    <span style="display: flex; align-items: center; gap: 20px; min-width: 0">
      <img src="/assets/pageaplomb-66befc.png" alt="Logo de la réforme Facturation électronique" width="441" height="151" loading="lazy" decoding="async" style="display: block; background: #ffffff; padding: 6px 10px; border-radius: 8px; height: 54px; width: auto; flex: none" />
      <span style="display: flex; flex-direction: column; line-height: 1.4; padding-left: 20px; border-left: 1px solid rgba(255,255,255,0.22)">
        <b style="font-size: 16px">Aplomb vous prépare à la facture électronique</b>
        <span style="font-size: 14px; color: #C3D0EA">Réception obligatoire depuis sept. 2026 · émission pour les PME et TPE en sept. 2027</span>
      </span>
    </span>
    <a class="fe" href="https://www.impots.gouv.fr" target="_blank" rel="noopener" style="display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-size: 15px; font-weight: 700; color: #ffffff; text-decoration: none">Informations officielles, impots.gouv.fr <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" /></svg></a>
  </div>
</div>
<section id="sur-mesure" style="font-family: Inter, system-ui, sans-serif; box-sizing: border-box; padding: 96px 0; color: #06255A; background: #F3F6FC">
  <div style="display: flex; flex-direction: column; gap: 48px">
    <div style="padding: 0 clamp(20px, 4vw, 48px); display: flex; flex-direction: column; gap: 18px; align-items: center; text-align: center">
