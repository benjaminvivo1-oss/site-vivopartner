                            <rect x="4" y="3" width="16" height="18" rx="2.5" />
                            <path d="M8 8h8M8 12h8M8 16h4" />
                          </svg>
                        </span>
                        <span style="display: flex; flex-direction: column; line-height: 1.2">
                          <span style="font-size: 11px; color: #5B6B8F">Devis ouverts</span>
