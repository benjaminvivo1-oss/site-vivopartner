                            <b style="font-size: 20px">4</b>
                            <span style="font-size: 10px; font-weight: 700; color: #2E9E5B">↑ 2</span>
                          </span>
                        </span>
                      </div>
                      <div style="flex: 1; min-width: 0; padding: 12px 14px; border-radius: 14px; background: #ffffff; box-shadow: 0 4px 14px rgba(6,37,90,0.06); display: flex; align-items: center; gap: 10px">
                        <span style="flex: none; width: 34px; height: 34px; border-radius: 11px; background: #E8F7EE; color: #1E8A4C; display: flex; align-items: center; justify-content: center">
                          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M17 6.5A6 6 0 1 0 17 17.5M5 10h8M5 14h8" />
                          </svg>
                        </span>
                        <span style="display: flex; flex-direction: column; line-height: 1.2">
                          <span style="font-size: 11px; color: #5B6B8F">À encaisser</span>
                          <span style="display: flex; align-items: baseline; gap: 6px">
                            <b style="font-size: 20px">2</b>
                            <span style="font-size: 10px; font-weight: 700; color: #2E9E5B"></span>
                          </span>
                        </span>
                      </div>
                      <div style="flex: 1; min-width: 0; padding: 12px 14px; border-radius: 14px; background: #ffffff; box-shadow: 0 4px 14px rgba(6,37,90,0.06); display: flex; align-items: center; gap: 10px">
                        <span style="flex: none; width: 34px; height: 34px; border-radius: 11px; background: #FFF0E6; color: #C2601A; display: flex; align-items: center; justify-content: center">
                          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
