                            </linearGradient>
                          </defs>
                          <path d="M0 100 C 30 90, 50 60, 80 70 S 130 110, 160 80 S 210 20, 250 40 S 300 90, 330 55 S 390 20, 420 30 L420 130 L0 130Z" fill="url(#ag)" />
                          <path d="M0 100 C 30 90, 50 60, 80 70 S 130 110, 160 80 S 210 20, 250 40 S 300 90, 330 55 S 390 20, 420 30" fill="none" stroke="#F58220" stroke-width="2.5" stroke-linecap="round" />
                          <path d="M0 115 C 40 105, 70 95, 110 100 S 190 70, 240 85 S 330 100, 420 70" fill="none" stroke="#06255A" stroke-width="2" stroke-dasharray="5 5" opacity=".55" />
                        </svg>
                      </div>
                      <div style="flex: 1; min-width: 0; padding: 14px; border-radius: 16px; background: #ffffff; box-shadow: 0 4px 14px rgba(6,37,90,0.06); display: flex; flex-direction: column; align-items: center; gap: 8px">
                        <b style="font-size: 13px; align-self: flex-start">Encaissé</b>
                        <span style="width: 96px; height: 96px; border-radius: 50%; background: conic-gradient(#F58220 0 78%, #FFE2C6 78% 100%); display: flex; align-items: center; justify-content: center">
                          <span style="width: 68px; height: 68px; border-radius: 50%; background: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 20px">78 %</span>
                        </span>
                        <span style="font-size: 11px; font-weight: 700; color: #2E9E5B">↑ 16 % ce mois-ci</span>
                      </div>
                      <div style="flex: 1.2; min-width: 0; padding: 14px; border-radius: 16px; background: #ffffff; box-shadow: 0 4px 14px rgba(6,37,90,0.06); display: flex; flex-direction: column; gap: 10px">
                        <b style="font-size: 13px">Activité récente</b>
                        <div style="display: flex; align-items: center; gap: 10px; font-size: 12px">
                          <span style="flex: none; width: 30px; height: 30px; border-radius: 50%; background: #F58220; color: #ffffff; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 12px">D</span>
                          <span style="flex: 1; min-width: 0; display: flex; flex-direction: column; line-height: 1.3">
                            <b>Devis Fenêtres</b>
                            <span style="color: #5B6B8F">Relance envoyée</span>
                          </span>
                          <span style="font-size: 11px; color: #8896B3">2 min</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 10px; font-size: 12px">
                          <span style="flex: none; width: 30px; height: 30px; border-radius: 50%; background: #2E9E5B; color: #ffffff; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 12px">F</span>
                          <span style="flex: 1; min-width: 0; display: flex; flex-direction: column; line-height: 1.3">
                            <b>Facture Extension</b>
                            <span style="color: #5B6B8F">Payée</span>
                          </span>
                          <span style="font-size: 11px; color: #8896B3">15 min</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 10px; font-size: 12px">
                          <span style="flex: none; width: 30px; height: 30px; border-radius: 50%; background: #4F6FD0; color: #ffffff; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 12px">T</span>
                          <span style="flex: 1; min-width: 0; display: flex; flex-direction: column; line-height: 1.3">
                            <b>Facture Toiture</b>
                            <span style="color: #5B6B8F">Rappel J+7</span>
                          </span>
                          <span style="font-size: 11px; color: #8896B3">1 h</span>
