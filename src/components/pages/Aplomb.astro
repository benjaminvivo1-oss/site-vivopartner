                        <span style="display: flex; justify-content: space-between; font-size: 13px; font-weight: 800">
                          <span>Encaissements</span>
                          <span style="font-size: 11px; font-weight: 600; color: #5B6B8F">6 derniers mois</span>
                        </span>
                        <svg viewBox="0 0 420 130" width="100%" height="130" preserveAspectRatio="none" aria-hidden="true">
                          <defs>
                            <linearGradient id="ag" x1="0" y1="0" x2="0" y2="1">
                              <stop offset="0" stop-color="#F58220" stop-opacity=".35" />
