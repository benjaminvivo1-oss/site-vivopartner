          <div style="position: absolute; left: 50%; top: 44px; width: 240px; margin-left: -120px; box-sizing: border-box; border-radius: 38px 38px 0 0; background: #0B1220; padding: 9px 9px 0; box-shadow: 0 24px 48px rgba(0,0,0,0.4)">
