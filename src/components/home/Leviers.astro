              </div>
              <div style="display: flex; gap: 6px; padding: 8px 10px; background: #14131C">
                <span style="flex: 1; height: 30px; border-radius: 5px; background: #24222F"></span>
                <span style="flex: 1; height: 30px; border-radius: 5px; background: #24222F"></span>
                <span style="flex: 1; height: 30px; border-radius: 5px; background: #24222F"></span>
              </div>
              </Fragment>
              )}
            </div>
          </div>
        </div>
        <div style="display: flex; flex-direction: column; gap: 14px; padding: 0 16px; flex: 1">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#F58220" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 5v14M6 13l6 6 6-6" />
          </svg>
