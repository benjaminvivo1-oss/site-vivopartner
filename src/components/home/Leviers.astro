---
import { Image } from 'astro:assets';
import { maquette } from '../../data/maquettes';

const shots = { climatisation: maquette('climatisation'), renovation: maquette('renovation'), electricite: maquette('electricite') };
---

<section id="leviers" data-screen-label="Home — leviers" style="font-family: Inter, system-ui, sans-serif; color: #ffffff; box-sizing: border-box; padding: clamp(72px,7.8cqi,112px) clamp(18px,4cqi,64px); background: #06255A">
  <div style="max-width: 1200px; margin: 0 auto; display: flex; flex-direction: column; gap: 64px">
    <div style="display: flex; flex-direction: column; gap: 24px; align-items: flex-start">
      <span style="font-family: 'JetBrains Mono', monospace; font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; color: #F58220; border: 1px solid #B45309; border-radius: 999px; padding: 8px 16px">La solution</span>
      <h2 style="margin: 0; font-family: Satoshi,Inter,sans-serif; font-size: clamp(34px, 5vw, 56px); line-height: 1.1; font-weight: 800; letter-spacing: -0.02em; max-width: 900px">3 problématiques, <span style="color: #F58220">3 leviers.</span></h2>
      <p style="margin: 0; font-size: 20px; line-height: 1.5; color: #C3D0EA; max-width: 620px">Un problème, un levier, un aperçu de ce que vous aurez.</p>
    </div>
    <div style="display: flex; flex-wrap: wrap; gap: 24px; align-items: stretch">
      <div class="vp-card" data-fan="1" style="position: relative; flex: 1 1 320px; min-width: 0; box-sizing: border-box; display: flex; flex-direction: column; gap: 24px; padding: 12px 12px 28px; border-radius: 28px; background: #ffffff; border: 1px solid #DCE3F0; box-shadow: 0 12px 32px rgba(6,37,90,0.06); color: #06255A">
          <a class="vp-card-link" href="/visibilite-locale/" tabindex="-1" aria-hidden="true"></a>
        <div style="position: relative; height: 380px; overflow: hidden; border-radius: 20px; background-color: #06255A; background-image: radial-gradient(360px 240px at 80% 100%, rgba(245,130,32,0.22), transparent)">
          <a class="h-f073a7 rb" href="/visibilite-locale/" aria-label="Voir plus de maquettes de sites" style="position: absolute; z-index: 10; top: 14px; left: 14px; border: none; cursor: pointer; font-family: inherit; transition: background .2s; display: inline-flex; align-items: center; gap: 8px; box-sizing: border-box; min-height: 44px; padding: 0 18px; border-radius: 999px; background: #F58220; color: #06255A; font-size: 14px; font-weight: 700; text-decoration: none">Voir plus<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
          <span data-hh="1" style="position: absolute; z-index: 10; top: 26px; right: 20px; font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: #A9B8D6">Survolez</span>
          <div role="img" aria-label="Trois maquettes de sites internet pour le BTP qui s'ouvrent en éventail au survol" style="position: absolute; left: 0; right: 0; top: 0; bottom: 0">
            <div data-s="1" aria-hidden="true" style="position: absolute; left: 50%; top: 116px; width: 180px; height: 126px; margin-left: -90px; box-sizing: border-box; border-radius: 10px; overflow: hidden; background: #ffffff; box-shadow: 0 10px 24px rgba(0,0,0,0.35); transform-origin: 50% 240%; color: #06255A">
              <div style="height: 16px; background: #E8ECF4; display: flex; align-items: center; gap: 4px; padding: 0 8px">
                <span style="width: 5px; height: 5px; border-radius: 50%; background: #B9C3D8"></span>
                <span style="width: 5px; height: 5px; border-radius: 50%; background: #B9C3D8"></span>
                <span style="width: 5px; height: 5px; border-radius: 50%; background: #B9C3D8"></span>
              </div>
              {shots.renovation ? (
                <Image src={shots.renovation} alt="" width={360} widths={[180, 360]} sizes="180px" style="display: block; width: 100%; height: calc(100% - 16px); object-fit: cover; object-position: top" />
              ) : (
                <Fragment>
              <div style="height: 58px; box-sizing: border-box; background: #F4E9D8; padding: 10px; display: flex; flex-direction: column; gap: 6px">
                <span style="font-size: 12px; font-weight: 800; color: #7A2E16">Rénovation</span>
                <span style="height: 4px; width: 66%; border-radius: 3px; background: rgba(122,46,22,0.45)"></span>
                <span style="height: 12px; width: 44px; border-radius: 6px; background: #B5482A; margin-top: 2px"></span>
              </div>
              <div style="display: flex; gap: 6px; padding: 8px 10px; background: #FBF6EC">
                <span style="flex: 1; height: 30px; border-radius: 5px; background: #EFE3CC"></span>
                <span style="flex: 1; height: 30px; border-radius: 5px; background: #EFE3CC"></span>
                <span style="flex: 1; height: 30px; border-radius: 5px; background: #EFE3CC"></span>
              </div>
              </Fragment>
              )}
            </div>
            <div data-s="3" aria-hidden="true" style="position: absolute; left: 50%; top: 116px; width: 180px; height: 126px; margin-left: -90px; box-sizing: border-box; border-radius: 10px; overflow: hidden; background: #ffffff; box-shadow: 0 10px 24px rgba(0,0,0,0.35); transform-origin: 50% 240%; color: #06255A">
              <div style="height: 16px; background: #E8ECF4; display: flex; align-items: center; gap: 4px; padding: 0 8px">
                <span style="width: 5px; height: 5px; border-radius: 50%; background: #B9C3D8"></span>
                <span style="width: 5px; height: 5px; border-radius: 50%; background: #B9C3D8"></span>
                <span style="width: 5px; height: 5px; border-radius: 50%; background: #B9C3D8"></span>
              </div>
              {shots.electricite ? (
                <Image src={shots.electricite} alt="" width={360} widths={[180, 360]} sizes="180px" style="display: block; width: 100%; height: calc(100% - 16px); object-fit: cover; object-position: top" />
              ) : (
                <Fragment>
              <div style="height: 58px; box-sizing: border-box; background: #1B1F27; padding: 10px; display: flex; flex-direction: column; gap: 6px">
                <span style="font-size: 12px; font-weight: 800; color: #FFC72C">Électricité</span>
                <span style="height: 4px; width: 62%; border-radius: 3px; background: rgba(255,255,255,0.5)"></span>
                <span style="height: 12px; width: 44px; border-radius: 6px; background: #FFC72C; margin-top: 2px"></span>
              </div>
              <div style="display: flex; gap: 6px; padding: 8px 10px; background: #F2F3F6">
                <span style="flex: 1; height: 30px; border-radius: 5px; background: #DADDE5"></span>
                <span style="flex: 1; height: 30px; border-radius: 5px; background: #DADDE5"></span>
                <span style="flex: 1; height: 30px; border-radius: 5px; background: #DADDE5"></span>
              </div>
              </Fragment>
              )}
            </div>
            <div data-s="2" aria-hidden="true" style="position: absolute; left: 50%; top: 116px; width: 202px; height: 146px; margin-left: -90px; box-sizing: border-box; border-radius: 10px; overflow: hidden; background: #ffffff; box-shadow: 0 10px 24px rgba(0,0,0,0.35); transform-origin: 50% 240%; color: #06255A">
              <div style="height: 16px; background: #15141C; display: flex; align-items: center; gap: 4px; padding: 0 8px">
                <span style="width: 5px; height: 5px; border-radius: 50%; background: #6B7385"></span>
                <span style="width: 5px; height: 5px; border-radius: 50%; background: #6B7385"></span>
