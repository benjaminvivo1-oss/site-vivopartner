          <a class="vp-card-link" href="/aplomb/" tabindex="-1" aria-hidden="true"></a>
        <div style="position: relative; height: 380px; overflow: hidden; border-radius: 20px; background-color: #06255A; background-image: radial-gradient(360px 240px at 80% 100%, rgba(245,130,32,0.22), transparent)">
          <a class="h-f073a7 rb" href="/aplomb/" aria-label="Voir plus : Aplomb en détail" style="position: absolute; z-index: 10; top: 14px; left: 14px; border: none; cursor: pointer; font-family: inherit; transition: background .2s; display: inline-flex; align-items: center; gap: 8px; box-sizing: border-box; min-height: 44px; padding: 0 18px; border-radius: 999px; background: #F58220; color: #06255A; font-size: 14px; font-weight: 700; text-decoration: none">Voir plus<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
