---
/**
 * Accueil — hero (variante « postit » de la maquette).
 * Photo de fond : déposer un fichier dans src/assets/hero/ (jpg, png, webp ou avif, droits libres,
 * sans visage). Il est utilisé automatiquement, optimisé en AVIF/WebP et chargé en priorité.
 * Sans photo, le fond reste marine (#0B2F6B), comme la maquette.
 * Ouverture : le texte monte ligne à ligne, la carte « Diagnostic » se pose et se cale, le ruban se déroule,
 * les trois priorités s'écrivent l'une après l'autre, puis la pastille « 30 min » est tamponnée.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ROUTES } from '../../data/site';
import AuditCta from '../AuditCta.astro';

const photos = import.meta.glob<{ default: ImageMetadata }>('../../assets/hero/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});
const heroPhoto = Object.values(photos)[0]?.default;

const priorities = [
  { n: '01', title: 'Temps administratif', sub: 'heures perdues / semaine' },
  { n: '02', title: 'Demandes entrantes', sub: 'appels manqués' },
  { n: '03', title: 'Visibilité locale', sub: 'potentiel inexploité' },
];
const reassurance = ['30 min en visio', 'Sans engagement', 'Mené par le fondateur', 'Réponse sous 24h'];
---

<section
  data-screen-label="Home — hero"
  style="position:relative;overflow:hidden;background:#0B2F6B;padding:clamp(38px,5.6cqi,88px) clamp(18px,4cqi,64px) clamp(18px,2.2cqi,30px)"
>
  {heroPhoto && (
    <Picture
      src={heroPhoto}
      alt=""
      formats={['avif', 'webp']}
      widths={[640, 960, 1280, 1920, 2560]}
      sizes="100vw"
      priority
      style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover"
    />
  )}
  <div style="position:absolute;inset:0;background:linear-gradient(90deg,rgba(11,47,107,.92) 0%,rgba(11,47,107,.78) 55%,rgba(11,47,107,.55) 100%);pointer-events:none"></div>
  <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(248,250,252,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(248,250,252,.045) 1px,transparent 1px);background-size:64px 64px;pointer-events:none"></div>
  <div style="position:relative;display:flex;gap:clamp(28px,4cqi,64px);align-items:center;flex-wrap:wrap">
    <div style="flex:1 1 340px;min-width:0;max-width:520px">
      <div style="display:flex;align-items:center;gap:12px;animation:vpFade .7s .05s ease both">
        <span style="display:block;width:26px;height:2px;background:#F58220;flex:none;animation:vpRule .9s .15s cubic-bezier(.16,1,.3,1) both"></span>
        <span style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.13em;font-family:'JetBrains Mono',ui-monospace,monospace;color:#CBD5E1">
          Vivo Partner · BTP · Carcassonne et à distance
        </span>
      </div>
      <h1 style="margin:clamp(18px,2.4cqi,32px) 0 0;max-width:16ch;font-family:Satoshi,Inter,sans-serif;font-weight:500;font-size:clamp(32px,4.4cqi,60px);line-height:1.06;letter-spacing:-.04em;color:#F8FAFC;text-wrap:pretty;animation:vpRise .9s .12s cubic-bezier(.16,1,.3,1) both;text-align:left">
        Le partenaire digital des entreprises du BTP.
      </h1>
      <p style="margin:clamp(22px,2.8cqi,36px) 0 0;max-width:46ch;font-size:clamp(15px,1.25cqi,16.5px);line-height:1.68;color:#CBD5E1;animation:vpRise .9s .26s cubic-bezier(.16,1,.3,1) both">
        Moins d’administratif, plus aucun appel manqué, davantage de demandes de devis. On commence par auditer votre
        façon de travailler, puis on déploie uniquement les leviers utiles, sans vous imposer un logiciel ou une
        méthode.
      </p>
      <div style="display:flex;align-items:center;gap:clamp(18px,2.4cqi,34px);flex-wrap:wrap;margin-top:clamp(24px,3cqi,40px);animation:vpRise .9s .38s cubic-bezier(.16,1,.3,1) both">
        <AuditCta label="Réserver un audit gratuit" href={ROUTES.contact} />
        <a
          href="#leviers"
          class="hv-link-orange"
          style="font-size:13.5px;font-weight:600;color:#F8FAFC;border-bottom:1px solid rgba(248,250,252,.55);padding-bottom:3px;white-space:nowrap;cursor:pointer;transition:color .25s ease,border-color .25s ease"
        >
          Découvrir les 3 leviers <span class="vp-arrow">→</span>
        </a>
      </div>
      <ul style="list-style:none;margin:16px 0 0;padding:0;display:flex;flex-wrap:wrap;gap:8px 20px;font-size:12.5px;color:#CBD5E1;animation:vpRise .9s .44s cubic-bezier(.16,1,.3,1) both">
        {reassurance.map((r) => (
          <li>✓ {r}</li>
        ))}
      </ul>
    </div>
    <div style="flex:1.5 1 480px;min-width:0;display:flex;justify-content:center;padding:clamp(8px,1.6cqi,24px) 0">
      <div style="position:relative;width:100%;max-width:720px">
        <div style="position:relative;display:flex;justify-content:center;padding:clamp(20px,3cqi,48px) clamp(10px,3cqi,48px);animation:vpRise .9s .3s cubic-bezier(.16,1,.3,1) both">
          <div
            aria-hidden="true"
            style="position:absolute;top:clamp(34px,4.4cqi,66px);left:50%;width:min(420px,86%);height:70%;margin-left:min(-190px,-40%);background:rgba(248,250,252,.1);border:1px solid rgba(248,250,252,.14);border-radius:3px;transform:rotate(5deg)"
          ></div>
          <div
            class="hv-straighten"
            style="position:relative;width:100%;max-width:440px;background:#F8FAFC;color:#0F172A;border-radius:3px;padding:34px 30px 26px;transform:rotate(-2.2deg);box-shadow:0 24px 44px rgba(2,8,22,.4);transition:transform .35s cubic-bezier(.16,1,.3,1);--vp-settle:-2.6deg;animation:vpSettle 1.5s .3s cubic-bezier(.16,1,.3,1) backwards"
          >
            <span
              aria-hidden="true"
              style="position:absolute;top:-10px;left:50%;width:92px;height:20px;margin-left:-46px;background:rgba(245,130,32,.85);transform:rotate(2deg);animation:vpStick .5s .8s cubic-bezier(.16,1,.3,1) backwards"
            ></span>
            <div style="font-size:11.5px;font-weight:600;text-transform:uppercase;letter-spacing:.13em;font-family:'JetBrains Mono',ui-monospace,monospace;color:#0B2F6B">
              Diagnostic digital
            </div>
            <div style="margin-top:6px;font-size:14px;color:#64748B">3 priorités identifiées pour votre entreprise</div>
            <div style="display:grid;gap:14px;margin-top:20px">
              {priorities.map((p, i) => (
                <div
                  style={`display:flex;gap:14px;align-items:baseline${i ? ';border-top:1px dashed #CBD5E1;padding-top:14px' : ''};animation:vpRiseT .7s ${0.62 + i * 0.14}s cubic-bezier(.16,1,.3,1) backwards`}
                >
                  <span style="font-family:'JetBrains Mono',ui-monospace,monospace;font-size:13px;color:#B45309;flex:none">
                    {p.n}
                  </span>
                  <div>
                    <div style="font-size:17px;font-weight:600;color:#0F172A">{p.title}</div>
                    <div style="font-size:13.5px;color:#64748B">{p.sub}</div>
                  </div>
                </div>
              ))}
            </div>
          </div>
          <div style="position:absolute;right:clamp(0px,4cqi,60px);bottom:clamp(0px,1cqi,16px);background:#F58220;color:#0F172A;border-radius:2px;padding:14px 18px;transform:rotate(6deg);box-shadow:0 14px 28px rgba(2,8,22,.35);font-family:Satoshi,Inter,sans-serif;font-weight:500;font-size:16px;line-height:1.25;animation:vpStamp .55s 1.1s cubic-bezier(.16,1,.3,1) backwards">
            30 min
            <br />
            <span style="font-size:13px;font-weight:600">offert · sans engagement</span>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div style="position:relative;margin-top:clamp(26px,3.4cqi,52px);padding-top:16px;border-top:1px solid rgba(248,250,252,.18);display:flex;justify-content:flex-end;animation:vpFade 1s .6s ease both">
    <span style="font-size:13px;font-weight:600;color:#F8FAFC">
      Automatise aujourd’hui. <span style="color:#F58220">Accélère demain.</span>
    </span>
  </div>
</section>
