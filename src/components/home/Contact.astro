---
import { formAttrs } from '../../data/form';
import ServiceChoices from '../ServiceChoices.astro';
---

<section id="contact" data-screen-label="Home — contact" style="font-family: Inter, system-ui, sans-serif; color: #ffffff; box-sizing: border-box; padding: clamp(72px,7.8cqi,112px) clamp(18px,4cqi,64px); background: #06255A">
  <div style="max-width: 1200px; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 56px 72px; align-items: flex-start">
    <div style="flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 24px; align-items: flex-start">
      <span style="font-family: 'JetBrains Mono', monospace; font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; color: #F58220; border: 1px solid #B45309; border-radius: 999px; padding: 8px 16px">Contact</span>
      <h2 style="margin: 0; font-family: Satoshi,Inter,sans-serif; font-size: clamp(34px, 5vw, 56px); line-height: 1.1; font-weight: 800; letter-spacing: -0.02em">Parlons de <span style="color: #F58220">votre entreprise.</span></h2>
      <p style="margin: 0; font-size: 19px; line-height: 1.65; color: #C3D0EA; max-width: 520px; text-wrap: pretty">Laissez-moi vos coordonnées. Je vous rappelle sous 24h pour fixer un créneau de 30 minutes en visio.</p>
      <div style="display: flex; flex-direction: column; gap: 14px; font-size: 17px; font-weight: 600">
        <span style="display: inline-flex; align-items: center; gap: 10px"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F58220" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>30 min en visio, gratuit</span>
        <span style="display: inline-flex; align-items: center; gap: 10px"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F58220" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>On regarde vos vrais chiffres ensemble</span>
        <span style="display: inline-flex; align-items: center; gap: 10px"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F58220" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>Vous repartez avec des pistes concrètes</span>
      </div>
      <div style="display: flex; flex-direction: column; gap: 6px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,0.14); width: 100%; max-width: 520px">
        <span style="font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: #A9B8D6">Vous préférez m'appeler ?</span>
        <a class="h-5453cd" href="tel:+33640202246" style="display: inline-flex; align-items: center; min-height: 44px; font-size: 24px; font-weight: 700; color: #ffffff">06 40 20 22 46</a>
        <a class="h-5453cd" href="mailto:benjamin@vivopartner.com" style="display: inline-flex; align-items: center; min-height: 44px; font-size: 18px; font-weight: 700; color: #ffffff">benjamin@vivopartner.com</a>
      </div>
    </div>
    <form {...formAttrs} style="flex: 1 1 440px; min-width: 0; box-sizing: border-box; padding: clamp(24px, 3vw, 40px); border-radius: 28px; background: #ffffff; border: 1px solid #DCE3F0; box-shadow: 0 24px 48px rgba(6,37,90,0.1); display: flex; flex-direction: column; gap: 22px; color: #06255A">
      <div style="display: flex; flex-direction: column; gap: 16px; align-items: flex-start; padding: 24px 0; animation: vpRise .5s cubic-bezier(.16,1,.3,1) both" data-bind="if:formSent" data-form-success tabindex="-1" hidden>
        <div style="width: 52px; height: 52px; border-radius: 16px; background: #F58220; color: #06255A; display: flex; align-items: center; justify-content: center">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12.5l4.5 4.5L19 7.5" />
          </svg>
        </div>
        <h3 style="margin: 0; font-family: Satoshi,Inter,sans-serif; font-size: 26px; line-height: 1.2; font-weight: 800">Merci <span data-bind="text:formName"></span>, c'est noté.</h3>
        <p style="margin: 0; font-size: 17px; line-height: 1.6; color: #3E4F73">Je vous rappelle sous 24h pour fixer le créneau.</p>
      </div>
      <h3 style="margin: 0; font-family: Satoshi,Inter,sans-serif; font-size: 26px; line-height: 1.2; font-weight: 800" data-bind="if:formOpen">Je vous rappelle sous 24h</h3>
      <div style="display: flex; flex-wrap: wrap; gap: 22px" data-bind="if:formOpen">
        <div style="display: flex; flex-direction: column; gap: 8px; flex: 1 1 220px; min-width: 0">
          <label for="nom" style="font-size: 15px; font-weight: 700; color: #06255A">Prénom et nom</label>
          <input class="f-5ace18" id="nom" name="nom" type="text" autocomplete="name" placeholder="Jean Dupont" required aria-describedby="err-nom" style="box-sizing: border-box; width: 100%; min-height: 52px; padding: 14px 16px; border: 1.5px solid #C9D4EC; border-radius: 14px; background: #ffffff; font-family: inherit; font-size: 17px; color: #06255A; outline: none" />
          <p id="err-nom" data-field-error hidden style="margin: 0; font-size: 15px; font-weight: 600; color: #C0392B">Indiquez votre nom.</p>
        </div>
        <div style="display: flex; flex-direction: column; gap: 8px; flex: 1 1 220px; min-width: 0">
          <label for="tel" style="font-size: 15px; font-weight: 700; color: #06255A">Téléphone</label>
          <input class="f-5ace18" id="tel" name="tel" type="tel" autocomplete="tel" placeholder="06 00 00 00 00" required aria-describedby="err-tel" style="box-sizing: border-box; width: 100%; min-height: 52px; padding: 14px 16px; border: 1.5px solid #C9D4EC; border-radius: 14px; background: #ffffff; font-family: inherit; font-size: 17px; color: #06255A; outline: none" />
          <p id="err-tel" data-field-error hidden style="margin: 0; font-size: 15px; font-weight: 600; color: #C0392B">Indiquez un numéro de téléphone valide pour être rappelé.</p>
        </div>
      </div>
      <div style="display: flex; flex-wrap: wrap; gap: 22px" data-bind="if:formOpen">
        <div style="display: flex; flex-direction: column; gap: 8px; flex: 1 1 220px; min-width: 0">
          <label for="ent" style="font-size: 15px; font-weight: 700; color: #06255A">Entreprise</label>
          <input class="f-5ace18" id="ent" name="entreprise" type="text" autocomplete="organization" placeholder="Nom de votre entreprise" style="box-sizing: border-box; width: 100%; min-height: 52px; padding: 14px 16px; border: 1.5px solid #C9D4EC; border-radius: 14px; background: #ffffff; font-family: inherit; font-size: 17px; color: #06255A; outline: none" />
        </div>
        <div style="display: flex; flex-direction: column; gap: 8px; flex: 1 1 220px; min-width: 0">
          <label for="metier" style="font-size: 15px; font-weight: 700; color: #06255A">Votre métier</label>
          <input class="f-5ace18" id="metier" name="metier" type="text" placeholder="Plombier, maçon, électricien…" style="box-sizing: border-box; width: 100%; min-height: 52px; padding: 14px 16px; border: 1.5px solid #C9D4EC; border-radius: 14px; background: #ffffff; font-family: inherit; font-size: 17px; color: #06255A; outline: none" />
        </div>
      </div>
      <ServiceChoices />
      <div style="display: flex; flex-direction: column; gap: 8px" data-bind="if:formOpen">
        <label for="msg" style="font-size: 15px; font-weight: 700; color: #06255A">Votre besoin <span style="font-weight: 500; color: #5B6B8F">(facultatif)</span></label>
        <textarea class="f-5ace18" id="msg" name="message" placeholder="Ex. : je rate des appels sur les chantiers, je perds du temps sur mes devis…" style="box-sizing: border-box; width: 100%; min-height: 52px; padding: 14px 16px; border: 1.5px solid #C9D4EC; border-radius: 14px; background: #ffffff; font-family: inherit; font-size: 17px; color: #06255A; outline: none; min-height: 104px; resize: vertical"></textarea>
      </div>
      <p role="alert" data-form-error data-bind="if:formOpen" hidden style="margin: 0; font-size: 15px; font-weight: 600; color: #C0392B"></p>
      <div hidden>
        <label for="site-web">Ne pas remplir</label>
        <input id="site-web" name="site_web" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <button class="h-f073a7" type="submit" data-cta="1" style="border: none; cursor: pointer; font-family: inherit; color: #06255A; transition: background .2s; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; min-height: 76px; padding: 14px 40px; border-radius: 999px; background: #F58220; font-size: 20px; font-weight: 700" data-bind="if:formOpen">
        <span>Envoyer ma demande</span>
        <span style="font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase">Réponse sous 24h</span>
      </button>
      <p style="margin: 0; font-size: 13px; line-height: 1.55; color: #5B6B8F" data-bind="if:formOpen">Vos informations ne servent qu'à vous recontacter. Elles ne sont ni revendues ni partagées. <a href="/confidentialite/" style="color: #06255A; text-decoration: underline; cursor: pointer">Politique de confidentialité</a></p>
    </form>
  </div>
</section>
