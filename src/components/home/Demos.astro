---
/**
 * Accueil — « Nos leviers » : 3 démos en onglets avec lecture automatique (src/scripts/demos.ts).
 * La lecture s'arrête au survol, au focus, au premier clic, et peut être mise en pause (bouton ajouté
 * pour l'accessibilité, cf. docs/SEO-LOCAL-IA-UX.md §4).
 */
import SectionSep from '../SectionSep.astro';
import AplombDemo from '../demos/AplombDemo.astro';
import IaDemo from '../demos/IaDemo.astro';
import SerpLaptop from '../demos/SerpLaptop.astro';
import LandingPhone from '../demos/LandingPhone.astro';
import { ROUTES } from '../../data/site';

const tabs = [
  { title: 'Aplomb', sub: 'Structurer votre activité' },
  { title: 'Réceptionniste IA', sub: 'Ne plus rater un appel' },
  { title: 'Visibilité', sub: 'Être trouvé localement' },
];

const levers = [
  {
    href: ROUTES.aplomb,
    tag: 'Gain de temps',
    title: 'Aplomb',
    text: 'Une application construite sur mesure autour de vos process, vos équipes et votre façon de travailler.',
    cta: 'Découvrir Aplomb →',
    pad: 'padding:clamp(22px,2.6cqi,34px) clamp(18px,2.4cqi,34px) clamp(22px,2.6cqi,34px) 0;border-right:1px solid rgba(248,250,252,.16)',
  },
  {
    href: ROUTES.ia,
    tag: 'Acquisition',
    title: 'Réceptionniste IA',
    text: 'Plus aucun appel de chantier, message ou demande client qui se perd, tout centralisé au même endroit.',
    cta: 'Découvrir le réceptionniste IA →',
    pad: 'padding:clamp(22px,2.6cqi,34px) clamp(18px,2.4cqi,34px);border-right:1px solid rgba(248,250,252,.16)',
  },
  {
    href: ROUTES.visibilite,
    tag: 'Visibilité',
    title: 'Visibilité',
    text: 'Site internet, référencement local et publicités : à la carte selon vos besoins, pour générer des demandes de devis.',
    cta: 'Découvrir la visibilité →',
    pad: 'padding:clamp(22px,2.6cqi,34px) 0 clamp(22px,2.6cqi,34px) clamp(18px,2.4cqi,34px)',
  },
];

const roundBtn =
  'flex:none;box-sizing:content-box;width:46px;height:46px;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;border:1px solid rgba(248,250,252,.16);color:#F8FAFC;font-size:17px;transition:background .25s ease,border-color .25s ease,color .25s ease';
const pageLink =
  'font-size:13.5px;font-weight:600;color:#F58220;cursor:pointer;border-bottom:1px solid rgba(245,130,32,.4);padding-bottom:3px';
---

<section
  id="leviers"
  data-screen-label="Home — démos"
  data-demos
  style="position:relative;overflow:hidden;background:#0B2F6B;color:#F8FAFC;border-top:1px solid rgba(248,250,252,.12);padding:clamp(72px,9.5cqi,152px) clamp(18px,4cqi,64px);scroll-margin-top:64px"
>
  <SectionSep />
  <div
    aria-hidden="true"
    style="position:absolute;inset:0;background-image:linear-gradient(rgba(248,250,252,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(248,250,252,.035) 1px,transparent 1px);background-size:64px 64px;pointer-events:none"
  ></div>
  <div style="position:relative">
    <div style="display:flex;gap:24px clamp(20px,4cqi,64px);flex-wrap:wrap;align-items:flex-end;justify-content:space-between">
      <div style="flex:1 1 420px;min-width:0">
        <span style="font-family:'JetBrains Mono',ui-monospace,monospace;font-size:11px;text-transform:uppercase;letter-spacing:.13em;color:#F8FAFC">
          Nos leviers
        </span>
        <h2 style="margin:14px 0 0;max-width:20ch;font-family:Satoshi,Inter,sans-serif;font-weight:500;font-size:clamp(28px,4cqi,54px);line-height:1.05;letter-spacing:-.04em;color:#F8FAFC;text-wrap:pretty">
          Trois leviers de croissance, <span style="color:#F58220">montrés en action</span>
        </h2>
        <p style="margin:18px 0 0;max-width:52ch;font-size:15.5px;line-height:1.65;color:#CBD5E1">
          Chaque levier se déploie seul ou avec les autres, selon ce que révèle l’audit.
        </p>
      </div>
      <div style="flex:none;display:flex;gap:10px;align-items:center">
        <button
          type="button"
          class="btn-reset hv-arrow"
          data-action="togglePause"
          aria-label="Mettre la démo en pause"
          title="Mettre la démo en pause"
          style={roundBtn}
        >
          <span data-icon="pause" style="display:inline-flex">
            <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" fill="currentColor">
              <rect x="2.5" y="2" width="3" height="10" rx=".6"></rect>
              <rect x="8.5" y="2" width="3" height="10" rx=".6"></rect>
            </svg>
          </span>
          <span data-icon="play" hidden style="display:inline-flex">
            <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" fill="currentColor">
              <path d="M4 2.2v9.6a.6.6 0 0 0 .9.5l7.6-4.8a.6.6 0 0 0 0-1L4.9 1.7a.6.6 0 0 0-.9.5Z"></path>
            </svg>
          </span>
        </button>
        <button
          type="button"
          class="btn-reset hv-arrow"
          data-action="tabPrev"
          aria-label="Démo précédente"
          title="Démo précédente"
          style={roundBtn}
        >
          ←
        </button>
        <button
          type="button"
          class="btn-reset hv-arrow"
          data-action="tabNext"
          aria-label="Démo suivante"
          title="Démo suivante"
          style={roundBtn}
        >
          →
        </button>
      </div>
    </div>

    <div
      role="tablist"
      aria-label="Démonstrations des trois leviers"
      style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:18px clamp(18px,2.6cqi,40px);margin-top:clamp(40px,5cqi,72px)"
    >
      {tabs.map((t, i) => (
        <button
          type="button"
          role="tab"
          class="btn-reset demo-tab"
          id={`demo-tab-${i}`}
          aria-controls={`demo-panel-${i}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-tab={i}
        >
          <span style="display:flex;align-items:baseline;gap:14px">
            <span class="demo-tab__num">{String(i + 1).padStart(2, '0')}</span>
            <span style="display:block;min-width:0">
              <span class="demo-tab__title">{t.title}</span>
              <span style="display:block;margin-top:3px;font-size:13px;color:#CBD5E1">{t.sub}</span>
            </span>
          </span>
        </button>
      ))}
    </div>

    <div style="margin-top:clamp(36px,4.4cqi,64px)">
      <div
        role="tabpanel"
        id="demo-panel-0"
        aria-labelledby="demo-tab-0"
        data-tab-panel="0"
        style="animation:vpFade .5s ease both"
      >
        <div style="display:flex;flex-direction:column;gap:clamp(22px,2.6cqi,36px)">
          <div style="min-width:0">
            <AplombDemo captionColor="#CBD5E1" />
          </div>
        </div>
        <div style="margin-top:20px">
          <a href={ROUTES.aplomb} style={pageLink}>
            Voir la page Aplomb →
          </a>
        </div>
      </div>
      <div
        role="tabpanel"
        id="demo-panel-1"
        aria-labelledby="demo-tab-1"
        data-tab-panel="1"
        hidden
        style="animation:vpFade .5s ease both"
      >
        <IaDemo statusColor="#F8FAFC" />
        <div style="margin-top:20px">
          <a href={ROUTES.ia} style={pageLink}>
            Voir la page Réceptionniste IA →
          </a>
        </div>
      </div>
      <div
        role="tabpanel"
        id="demo-panel-2"
        aria-labelledby="demo-tab-2"
        data-tab-panel="2"
        hidden
        style="animation:vpFade .5s ease both"
      >
        <div style="display:flex;gap:clamp(18px,2.6cqi,40px);flex-wrap:wrap;align-items:flex-start">
          <div style="flex:1 1 460px;min-width:0">
            <SerpLaptop />
            <p style="margin:18px 0 0;font-family:'JetBrains Mono',ui-monospace,monospace;font-size:10.5px;text-transform:uppercase;letter-spacing:.1em;color:#CBD5E1">
              Positions d’exemple — mesurées à l’audit
            </p>
          </div>
          <div style="flex:0 1 286px;min-width:0;display:flex;flex-direction:column;gap:14px;align-items:center">
            <LandingPhone />
            <p style="margin:0;max-width:34ch;font-size:13.5px;line-height:1.6;color:#CBD5E1;text-align:center">
              La page mobile qui transforme la visite en demande de devis.
            </p>
          </div>
        </div>
        <div style="margin-top:20px">
          <a href={ROUTES.visibilite} style={pageLink}>
            Voir la page Visibilité →
          </a>
        </div>
      </div>
    </div>

    <div style="display:flex;flex-wrap:wrap;margin-top:clamp(34px,4.2cqi,64px);border-top:1px solid rgba(248,250,252,.16)">
      {levers.map((l, i) => (
        <a href={l.href} data-vp-reveal={i} style={`display:block;flex:1 1 260px;min-width:0;${l.pad};cursor:pointer`}>
          <div style="display:flex;align-items:baseline;gap:12px">
            <span style="font-family:'JetBrains Mono',ui-monospace,monospace;font-weight:700;font-size:22px;color:transparent;-webkit-text-stroke:1px #F58220">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span style="font-family:'JetBrains Mono',ui-monospace,monospace;font-size:10.5px;text-transform:uppercase;letter-spacing:.13em;color:#CBD5E1">
              {l.tag}
            </span>
          </div>
          <h3 style="margin:16px 0 0;font-family:Satoshi,Inter,sans-serif;font-weight:700;font-size:clamp(20px,2cqi,26px);letter-spacing:-.02em;color:#F8FAFC">
            {l.title}
          </h3>
          <p style="margin:9px 0 0;font-size:14.5px;line-height:1.62;color:#CBD5E1">{l.text}</p>
          <div style="margin-top:18px;font-size:13.5px;font-weight:600;color:#F58220">{l.cta}</div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .demo-tab {
    display: block;
    width: 100%;
    position: relative;
    cursor: pointer;
    padding: 22px 0 0;
    border-top: 2px solid rgba(248, 250, 252, 0.16);
    transition: border-color 0.3s ease;
  }
  .demo-tab:hover {
    border-color: rgba(248, 250, 252, 0.4);
  }
  .demo-tab[aria-selected='true'],
  .demo-tab[aria-selected='true']:hover {
    border-color: #f58220;
  }
  .demo-tab__num {
    font-family: Satoshi, Inter, sans-serif;
    font-weight: 500;
    font-size: clamp(30px, 3.2cqi, 44px);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1px #94a3b8;
  }
  .demo-tab[aria-selected='true'] .demo-tab__num {
    color: #f58220;
    -webkit-text-stroke: 0;
  }
  .demo-tab__title {
    display: block;
    font-family: Satoshi, Inter, sans-serif;
    font-weight: 500;
    font-size: clamp(16px, 1.5cqi, 19px);
    color: #cbd5e1;
    transition: color 0.3s ease;
  }
  .demo-tab[aria-selected='true'] .demo-tab__title {
    color: #f8fafc;
  }
</style>
