---
/**
 * Accueil — projets en cours (anonymisés).
 */
import SectionSep from '../SectionSep.astro';

const projects = [
  {
    lever: 'Aplomb',
    trade: 'Plomberie · climatisation',
    text: 'Application sur mesure pour la gestion administrative (devis, compta, administratif...) d’une entreprise de plomberie/climatisation',
    tags: ['Devis', 'Compta', 'Administratif'],
    tilt: '-1.6deg',
  },
  {
    lever: 'Visibilité',
    trade: 'Peinture',
    text: 'Refonte complète de site avec optimisation SEO et campagne pub Google pour une entreprise de peinture',
    tags: ['Site', 'SEO', 'Google Ads'],
    tilt: '1.2deg',
  },
  {
    lever: 'Aplomb',
    trade: 'Terrassement',
    text: 'Application sur mesure complexe avec 2 axes (bureau et terrain), pour une équipe de 8 personnes, pour une entreprise de terrassement',
    tags: ['Bureau', 'Terrain', '8 utilisateurs'],
    tilt: '-.8deg',
  },
];
---

<section style="position:relative;background:#0A2A5E;padding:clamp(72px,9.5cqi,152px) clamp(18px,4cqi,64px);border-top:1px solid rgba(248,250,252,.12)">
  <SectionSep />
  <div style="display:flex;gap:20px clamp(20px,4cqi,64px);flex-wrap:wrap;align-items:flex-end;justify-content:space-between">
    <div data-vp-reveal="0" style="flex:1 1 420px;min-width:0">
      <div style="font-size:11px;font-weight:500;text-transform:uppercase;letter-spacing:.13em;font-family:'JetBrains Mono',ui-monospace,monospace;color:#94A3B8">
        Où on en est
      </div>
      <h2 style="margin:16px 0 0;max-width:30ch;font-family:Satoshi,Inter,sans-serif;font-weight:500;font-size:clamp(25px,3.4cqi,46px);line-height:1.08;letter-spacing:-.04em;color:#F8FAFC;text-wrap:pretty">
        Chaque semaine, de nouveaux projets sur mesure prennent forme pour nos clients du BTP.
      </h2>
    </div>
    <p data-vp-reveal="1" style="margin:0;flex:0 1 300px;font-size:14px;line-height:1.6;color:#CBD5E1">
      Quelques projets réels en cours, présentés de façon anonyme pour respecter la confidentialité de nos clients.
    </p>
  </div>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:clamp(28px,3cqi,44px);margin-top:clamp(44px,5.4cqi,80px)">
    {projects.map((p, i) => (
      <div data-vp-reveal={i} style="padding-top:10px">
        <div
          class="hv-straighten vp-paper"
          style={`position:relative;height:100%;box-sizing:border-box;display:flex;flex-direction:column;background:#F8FAFC;color:#0F172A;border-radius:3px;padding:30px 24px 22px;transform:rotate(${p.tilt});box-shadow:0 20px 40px rgba(2,8,22,.35);transition:transform .35s cubic-bezier(.16,1,.3,1);--vp-settle:${p.tilt.startsWith('-') ? '-1.2deg' : '1.2deg'}`}
        >
          <span
            aria-hidden="true"
            style={`position:absolute;top:-9px;left:50%;width:78px;height:18px;margin-left:-39px;background:rgba(245,130,32,.85);transform:rotate(${i % 2 ? '-2deg' : '2deg'})`}
          />
          <div style="display:flex;justify-content:space-between;align-items:baseline;gap:12px">
            <span style="font-family:'JetBrains Mono',ui-monospace,monospace;font-size:13px;color:#B45309">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span style="display:inline-flex;align-items:center;gap:7px;font-size:11px;text-transform:uppercase;letter-spacing:.1em;font-family:'JetBrains Mono',ui-monospace,monospace;color:#0B2F6B">
              <span style="width:7px;height:7px;border-radius:50%;background:#F58220;animation:vpPulse 1.7s ease-in-out infinite" />
              En construction
            </span>
          </div>
          <div style="margin-top:18px;font-size:11px;text-transform:uppercase;letter-spacing:.12em;font-family:'JetBrains Mono',ui-monospace,monospace;color:#64748B">
            {p.lever}
          </div>
          <h3 style="margin:6px 0 0;font-family:Satoshi,Inter,sans-serif;font-weight:500;font-size:clamp(19px,1.8cqi,23px);letter-spacing:-.02em;color:#0B2F6B">
            {p.trade}
          </h3>
          <p style="margin:12px 0 0;flex:1 1 auto;font-size:14.5px;line-height:1.6;color:#475569;text-wrap:pretty">
            {p.text}
          </p>
          <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:18px;padding-top:14px;border-top:1px dashed #CBD5E1">
            {p.tags.map((t) => (
              <span style="padding:4px 9px;background:rgba(11,47,107,.07);border-radius:2px;font-size:11.5px;font-family:'JetBrains Mono',ui-monospace,monospace;color:#0B2F6B">
                {t}
              </span>
            ))}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
