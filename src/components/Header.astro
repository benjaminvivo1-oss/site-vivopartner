---
/**
 * En-tête de la maquette v3 (fichier principal, <header>). Les deux versions (ordinateur et mobile)
 * sont dans le HTML ; une requête @container affiche la bonne selon la largeur (900 px, comme la maquette).
 * Comportements dans src/scripts/site.ts : fond au défilement, menu Services, burger mobile.
 */
import { Image } from 'astro:assets';
import markLight from '../assets/brand/vp-mark-light.png';
import wordmarkLight from '../assets/brand/vp-wordmark-light.png';
import type { PageKey } from '../data/site';

interface Props {
  current?: PageKey;
}
const { current } = Astro.props;
const isService = current === 'aplomb' || current === 'receptionniste-ia' || current === 'visibilite-locale';
// Sur une page de service, « Audit gratuit » mène au formulaire dédié en bas de la page.
const ctaHref = isService ? '#contact' : '/contact/';

const navLink =
  'position:relative;padding:4px 0;color:#CBD5E1;cursor:pointer;white-space:nowrap;flex:none;transition:color .22s ease;text-decoration:none';
const navBar =
  'position:absolute;left:0;right:0;bottom:-2px;height:2px;background:#F58220;transform-origin:left;animation:vpBar .45s cubic-bezier(.16,1,.3,1) both';
const pill =
  'flex:none;position:relative;display:inline-flex;align-items:center;justify-content:center;height:36px;padding:0 16px;border-radius:999px;background:#06255A;color:#FFFFFF;font-size:13px;font-weight:700;white-space:nowrap;cursor:pointer;transition:background .2s ease,color .2s ease,transform .2s ease;text-decoration:none';
const pillDot =
  'position:absolute;top:-3px;right:-3px;display:block;width:10px;height:10px;border-radius:50%;background:#F58220;border:2px solid #FFFFFF';
const mLink =
  'display:flex;align-items:center;justify-content:space-between;padding:14px 0;border-bottom:1px solid rgba(248,250,252,.08);font-size:16px;color:#F8FAFC;cursor:pointer;text-decoration:none';
const mSub =
  'display:flex;align-items:center;justify-content:space-between;padding:12px 0 12px 16px;border-bottom:1px solid rgba(248,250,252,.06);font-size:15px;color:#CBD5E1;cursor:pointer;text-decoration:none';
const mPage =
  "font-size:11px;text-transform:uppercase;letter-spacing:.12em;font-family:'JetBrains Mono',ui-monospace,monospace;color:#F58220";
const cta =
  'flex:none;display:inline-flex;align-items:center;gap:8px;background:#F58220;color:#0F172A;border:none;border-radius:999px;padding:4px 18px;min-height:40px;box-sizing:border-box;font-size:12.5px;font-weight:600;white-space:nowrap;cursor:pointer;font-family:inherit;box-shadow:0 8px 20px rgba(245,130,32,.22);transition:background .28s ease,transform .28s ease,box-shadow .28s ease';

const main = [
  { key: 'a-propos', href: '/a-propos/', label: 'À propos' },
  { key: 'faq', href: '/faq/', label: 'FAQ' },
  { key: 'contact', href: '/contact/', label: 'Contact' },
] as const;
const services = [
  { key: 'aplomb', href: '/aplomb/', label: 'Aplomb' },
  { key: 'receptionniste-ia', href: '/receptionniste-ia/', label: 'Réceptionniste IA' },
  { key: 'visibilite-locale', href: '/visibilite-locale/', label: 'Visibilité' },
] as const;
const aria = (key: string) => (current === key ? ({ 'aria-current': 'page' } as const) : {});
---

<header
  data-header
  style="position:sticky;top:0;z-index:40;transition:background .45s ease,backdrop-filter .45s ease,border-color .45s ease,box-shadow .45s ease;background:#0B2F6B;backdrop-filter:none;-webkit-backdrop-filter:none;border-bottom:1px solid rgba(248,250,252,0);box-shadow:none"
>
  <div data-mobile-only>
    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;padding:8px 18px 12px">
      <a
        href="/"
        style="display:flex;align-items:center;gap:9px;cursor:pointer;text-decoration:none;color:inherit"
        {...aria('accueil')}
      >
        <Image
          src={markLight}
          alt=""
          width={86}
          height={61}
          loading="eager"
          style="height:30px;width:auto;display:block;flex:none"
        />
        <Image
          src={wordmarkLight}
          alt="Vivo Partner — accueil"
          width={250}
          height={34}
          loading="eager"
          style="height:17px;width:auto;display:block"
        />
      </a>
      <div style="display:flex;align-items:center;gap:6px">
        <a class="h-695a2a rb" href={ctaHref} data-cta="1" style={cta}>
          <span>Audit gratuit</span>
        </a>
        <button
          class="rb"
          type="button"
          aria-label="Ouvrir le menu"
          aria-expanded="false"
          aria-controls="menu-mobile"
          data-menu-toggle
          style="width:44px;height:44px;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:5px;cursor:pointer"
        >
          <span style="display:block;width:20px;height:1.5px;background:#F8FAFC"></span>
          <span style="display:block;width:20px;height:1.5px;background:#F8FAFC"></span>
          <span style="display:block;width:20px;height:1.5px;background:#F8FAFC"></span>
        </button>
      </div>
    </div>
    <nav
      id="menu-mobile"
      aria-label="Menu mobile"
      hidden
      style="border-top:1px solid rgba(248,250,252,.07);padding:6px 18px 14px;animation:vpRise .4s cubic-bezier(.16,1,.3,1) both"
    >
      <a href="/" style={mLink} {...aria('accueil')}>
        Accueil{current === 'accueil' && <span style={mPage}>Page</span>}
      </a>
      <button
        class="rb"
        type="button"
        aria-expanded="false"
        aria-controls="svc-mobile"
        data-svc-toggle
        style={mLink + ';width:100%;box-sizing:border-box;text-align:left'}
      >
        Services
        <i
          aria-hidden="true"
          style="display:block;width:6px;height:6px;border-right:1.6px solid #94A3B8;border-bottom:1.6px solid #94A3B8;transform:rotate(45deg) translateY(-2px)"
        ></i>
      </button>
      <div id="svc-mobile" hidden style="animation:vpRise .3s cubic-bezier(.16,1,.3,1) both">
        {services.map((s) => (
          <a href={s.href} style={mSub} {...aria(s.key)}>
            {s.label}
            {current === s.key && <span style={mPage}>Page</span>}
          </a>
        ))}
      </div>
      {main.map((m, i) => (
        <a
          href={m.href}
          style={i === main.length - 1 ? mLink.replace(';border-bottom:1px solid rgba(248,250,252,.08)', '') : mLink}
          {...aria(m.key)}
        >
          {m.label}
          {current === m.key && <span style={mPage}>Page</span>}
        </a>
      ))}
    </nav>
  </div>

  <div
    data-desktop-only
    style="display:flex;align-items:center;justify-content:space-between;gap:clamp(12px,1.6cqi,32px);flex-wrap:nowrap;padding:14px clamp(18px,4cqi,64px)"
  >
    <a
      href="/"
      style="display:flex;align-items:center;gap:9px;cursor:pointer;flex:none;text-decoration:none;color:inherit"
      {...aria('accueil')}
    >
      <Image
        src={markLight}
        alt=""
        width={74}
        height={52}
        loading="eager"
        style="height:26px;width:auto;display:block;flex:none"
      />
      <Image
        src={wordmarkLight}
        alt="Vivo Partner — accueil"
        width={220}
        height={30}
        loading="eager"
        style="height:15px;width:auto;display:block;flex:none"
      />
    </a>
    <nav
      aria-label="Menu principal"
      style="display:flex;align-items:center;gap:clamp(8px,1.1cqi,20px);flex-wrap:nowrap;min-width:0;font-size:13px;font-weight:500"
    >
      <a class="h-6c01f9" href="/" style={navLink} {...aria('accueil')}>
        Accueil{current === 'accueil' && <span style={navBar}></span>}
      </a>
      <span
        data-svc
        style="position:relative;padding:4px 0;color:#CBD5E1;white-space:nowrap;flex:none;display:inline-flex;align-items:center;gap:6px;transition:color .22s ease"
      >
        <button
          class="h-6c01f9 rb"
          type="button"
          aria-expanded="false"
          aria-controls="svc-menu"
          data-svc-toggle
          style="display:inline-flex;align-items:center;gap:6px;cursor:pointer;color:inherit;transition:color .22s ease"
        >
          Services
          <i
            aria-hidden="true"
            data-svc-caret
            style="display:block;width:5px;height:5px;border-right:1.4px solid currentColor;border-bottom:1.4px solid currentColor;transform:rotate(45deg) translate(-1px,-1px);transition:transform .25s ease"
          ></i>
        </button>
        {isService && <span style={navBar}></span>}
        <span
          id="svc-menu"
          hidden
          style="position:absolute;top:calc(100% + 14px);left:-14px;z-index:60;display:flex;flex-direction:column;gap:8px;padding:10px 10px 10px;border-radius:20px;background:#FFFFFF;border-top:3px solid #F58220;box-shadow:0 18px 40px rgba(2,8,22,.45);animation:vpRise .28s cubic-bezier(.16,1,.3,1) both"
        >
          <i style="position:absolute;top:-9px;left:34px;display:block;width:14px;height:14px;background:#F58220;transform:rotate(45deg);border-radius:2px"></i>
          <span style="position:relative;padding:2px 6px 0;font-family:'JetBrains Mono',ui-monospace,monospace;font-size:10.5px;text-transform:uppercase;letter-spacing:.12em;color:#B45309">
            Services
          </span>
          <span style="position:relative;display:flex;gap:8px">
            {services.map((s) => (
              <a class="h-1f4fe9" href={s.href} style={pill} {...aria(s.key)}>
                {s.label}
                {current === s.key && <i style={pillDot} />}
              </a>
            ))}
          </span>
        </span>
      </span>
      {main.map((m) => (
        <a class="h-6c01f9" href={m.href} style={navLink} {...aria(m.key)}>
          {m.label}
          {current === m.key && <span style={navBar} />}
        </a>
      ))}
      <a class="h-695a2a rb" href={ctaHref} data-cta="1" style={cta}>
        <span>Audit gratuit</span>
      </a>
    </nav>
  </div>
  <span data-progress aria-hidden="true"></span>
</header>
