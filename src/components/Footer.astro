---
/** Pied de page et barre d'actions mobile de la maquette v3 (fichier principal). */
import { Image } from 'astro:assets';
import lockupLight from '../assets/brand/vp-lockup-light.png';
import type { PageKey } from '../data/site';

interface Props {
  current?: PageKey;
}
const { current } = Astro.props;
// Sur une page de service, « Audit gratuit » (barre mobile) mène au formulaire dédié en bas de la page.
const ctaHref =
  current === 'aplomb' || current === 'receptionniste-ia' || current === 'visibilite-locale' ? '#contact' : '/contact/';
---

<footer style="background:#041A40;border-top:1px solid rgba(248,250,252,.1);border-top:1px solid rgba(248,250,252,.07);padding:clamp(40px,5cqi,72px) clamp(18px,4cqi,64px) clamp(28px,3cqi,44px)">
  <div style="display: flex; gap: clamp(28px,4cqi,72px); flex-wrap: wrap; justify-content: space-between; align-items: flex-start">
    <div style="flex:0 1 200px;min-width:0">
      <Image
        src={lockupLight}
        alt="Vivo Partner — Automatise aujourd’hui. Accélère demain."
        width={386}
        height={72}
        style="height:36px;width:auto;max-width:100%;display:block"
      />
    </div>
    <div style="flex:1 1 auto;min-width:0;display:flex;gap:clamp(28px,4cqi,72px);flex-wrap:wrap;justify-content:flex-end">
      <div style="flex:0 0 auto">
        <div style="font-size:11px;text-transform:uppercase;letter-spacing:.12em;font-family:'JetBrains Mono',ui-monospace,monospace;color:#94A3B8;margin-bottom:14px">
          Contact
        </div>
        <address style="display:flex;flex-direction:column;gap:9px;font-size:14.5px;color:#CBD5E1;font-style:normal">
          <span style="color:#F8FAFC;font-weight:600">Vivo Partner</span>
          <a href="mailto:benjamin@vivopartner.com" style="color:inherit;text-decoration:none">
            benjamin@vivopartner.com
          </a>
          <a href="tel:+33640202246" style="color:inherit;text-decoration:none">
            06 40 20 22 46
          </a>
          <span style="color:#94A3B8">Carcassonne (Aude) · France et pays francophones</span>
        </address>
      </div>
      <div style="flex:0 0 auto">
        <div style="font-size:11px;text-transform:uppercase;letter-spacing:.12em;font-family:'JetBrains Mono',ui-monospace,monospace;color:#94A3B8;margin-bottom:14px">
          Services
        </div>
        <div style="display:flex;flex-direction:column;gap:9px;font-size:14.5px;color:#CBD5E1">
          <a href="/aplomb/" style="cursor:pointer;text-decoration:none;color:inherit">
            Aplomb
          </a>
          <a href="/receptionniste-ia/" style="cursor:pointer;text-decoration:none;color:inherit">
            Réceptionniste IA
          </a>
          <a href="/visibilite-locale/" style="cursor:pointer;text-decoration:none;color:inherit">
            Visibilité
          </a>
        </div>
      </div>
      <div style="flex:0 0 auto">
        <div style="font-size:11px;text-transform:uppercase;letter-spacing:.12em;font-family:'JetBrains Mono',ui-monospace,monospace;color:#94A3B8;margin-bottom:14px">
          Cabinet
        </div>
        <div style="display:flex;flex-direction:column;gap:9px;font-size:14.5px;color:#CBD5E1">
          <a href="/a-propos/" style="cursor:pointer;text-decoration:none;color:inherit">
            À propos
          </a>
          <a href="/faq/" style="cursor:pointer;text-decoration:none;color:inherit">
            FAQ
          </a>
          <a href="/contact/" style="cursor:pointer;text-decoration:none;color:inherit">
            Contact
          </a>
          <a href="/mentions-legales/" style="cursor:pointer;text-decoration:none;color:inherit">
            Mentions légales
          </a>
          <a href="/confidentialite/" style="cursor:pointer;text-decoration:none;color:inherit">
            Confidentialité
          </a>
        </div>
      </div>
    </div>
  </div>
  <div style="margin-top:clamp(28px,3cqi,44px);padding-top:18px;border-top:1px solid rgba(248,250,252,.1);display:flex;gap:16px;flex-wrap:wrap;justify-content:space-between;font-size:12.5px;color:#94A3B8">
    <span>Vivo Partner — Benjamin Vivo · SIRET 101 538 791 00019</span>
    <span>© 2026 Vivo Partner</span>
  </div>
</footer>
<div data-mobile-only>
  <div style="height:72px"></div>
  <nav
    aria-label="Contact rapide"
    style="position:fixed;left:0;right:0;bottom:0;z-index:45;display:flex;gap:8px;padding:10px 12px calc(10px + env(safe-area-inset-bottom));background:rgba(15,23,42,.94);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-top:1px solid rgba(248,250,252,.07)"
  >
    <a
      href="tel:+33640202246"
      style="flex:1 1 0;height:48px;background:transparent;color:#F8FAFC;border:1px solid rgba(248,250,252,.3);border-radius:999px;display:flex;align-items:center;justify-content:center;gap:8px;font-family:inherit;font-size:14.5px;font-weight:600;cursor:pointer;text-decoration:none;box-sizing:border-box;padding:1px 6px"
    >
      Appeler
    </a>
    <a
      class="rb"
      href={ctaHref}
      data-cta="1"
      style="flex:1.4 1 0;height:48px;display:flex;align-items:center;justify-content:center;gap:8px;background:#F58220;color:#0F172A;border:none;border-radius:999px;padding:4px 16px;box-sizing:border-box;font-size:14.5px;font-weight:600;font-family:inherit;cursor:pointer"
    >
      <span style="display:flex;align-items:center;gap:8px">
        <span>Audit gratuit</span>
      </span>
    </a>
  </nav>
</div>
