---
/** Cadre « smartphone » des démos (réceptionniste IA, page mobile Visibilité), avec barre d'état. */
interface Props {
  screen?: string;
}
const { screen = '#F2F2F7' } = Astro.props;
const sys = "font-family:Inter,-apple-system,BlinkMacSystemFont,'Helvetica Neue',sans-serif";
---

<div style="position:relative;width:248px;max-width:100%;flex:none;background:linear-gradient(150deg,#4A5770 0%,#232C3D 46%,#151C29 100%);border-radius:46px;padding:11px;box-shadow:0 34px 60px rgba(2,8,22,.6),inset 0 1px 0 rgba(248,250,252,.18)">
  <span
    aria-hidden="true"
    style="position:absolute;left:-2px;top:86px;width:3px;height:26px;border-radius:2px;background:linear-gradient(#4A5770,#1B2331)"
  ></span>
  <span
    aria-hidden="true"
    style="position:absolute;left:-2px;top:122px;width:3px;height:44px;border-radius:2px;background:linear-gradient(#4A5770,#1B2331)"
  ></span>
  <span
    aria-hidden="true"
    style="position:absolute;right:-2px;top:110px;width:3px;height:56px;border-radius:2px;background:linear-gradient(#4A5770,#1B2331)"
  ></span>
  <div style="position:relative;background:#0B1424;border-radius:36px;overflow:hidden;box-shadow:inset 0 0 0 3px #05090F">
    <span
      aria-hidden="true"
      style="position:absolute;top:11px;left:50%;transform:translateX(-50%);width:72px;height:21px;border-radius:13px;background:#05090F;z-index:3"
    ></span>
    <span
      aria-hidden="true"
      style="position:absolute;bottom:7px;left:50%;transform:translateX(-50%);width:86px;height:4px;border-radius:3px;background:rgba(11,11,15,.28);z-index:3"
    ></span>
    <span
      aria-hidden="true"
      style="position:absolute;inset:0;z-index:2;background:linear-gradient(122deg,rgba(255,255,255,.22) 0%,rgba(255,255,255,0) 30%,rgba(255,255,255,0) 82%,rgba(255,255,255,.12) 100%);pointer-events:none"
    ></span>
    <div style={`background:${screen};padding:14px 0 28px`}>
      <div
        aria-hidden="true"
        style="display:flex;align-items:center;justify-content:space-between;padding:0 8px 0 12px"
      >
        <span style={`${sys};font-size:12.5px;font-weight:600;color:#0B0B0F;letter-spacing:.01em`}>7:42</span>
        <span style="display:flex;align-items:flex-end;gap:5px">
          <span style="display:flex;align-items:flex-end;gap:1.5px">
            <i style="display:block;width:2.5px;height:4px;border-radius:1px;background:#0B0B0F"></i>
            <i style="display:block;width:2.5px;height:6px;border-radius:1px;background:#0B0B0F"></i>
            <i style="display:block;width:2.5px;height:8px;border-radius:1px;background:#0B0B0F"></i>
            <i style="display:block;width:2.5px;height:10px;border-radius:1px;background:rgba(11,11,15,.28)"></i>
          </span>
          <span style="position:relative;display:block;width:12px;height:9px">
            <i style="position:absolute;left:4.5px;bottom:0;width:3px;height:3px;border-radius:50%;background:#0B0B0F"></i>
            <i style="position:absolute;left:1px;bottom:3px;width:10px;height:6px;border:1.6px solid #0B0B0F;border-bottom:none;border-radius:6px 6px 0 0"></i>
          </span>
          <span style="display:flex;align-items:center;gap:1px">
            <span style="display:block;box-sizing:border-box;width:19px;height:10px;border:1px solid rgba(11,11,15,.35);border-radius:3px;padding:1.5px">
              <i style="display:block;width:72%;height:100%;background:#0B0B0F;border-radius:1.5px"></i>
            </span>
            <i style="display:block;width:1.5px;height:4px;background:rgba(11,11,15,.35);border-radius:0 1px 1px 0"></i>
          </span>
        </span>
      </div>
      <slot />
    </div>
  </div>
</div>
