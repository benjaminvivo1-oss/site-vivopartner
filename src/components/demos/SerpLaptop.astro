---
/** Écran « résultats Google » de la démo Visibilité (portable). Positions et données d'exemple. */
import LaptopFrame from './LaptopFrame.astro';
---

<LaptopFrame maxWidth="860px">
  <div style="display:flex;align-items:center;gap:9px;padding:8px 11px;background:#E4E7EB;border-bottom:1px solid #D2D6DB">
    <span style="display:flex;gap:5px;flex:none">
      <i style="display:block;width:8px;height:8px;border-radius:50%;background:#FF5F57"></i>
      <i style="display:block;width:8px;height:8px;border-radius:50%;background:#FEBC2E"></i>
      <i style="display:block;width:8px;height:8px;border-radius:50%;background:#28C840"></i>
    </span>
    <span style="flex:0 1 190px;min-width:0;display:flex;align-items:center;gap:6px;background:#FFFFFF;border-radius:8px 8px 0 0;padding:6px 9px">
      <i style="flex:none;display:block;width:10px;height:10px;border-radius:50%;background:#1A73E8"></i>
      <i style="min-width:0;font-family:Inter,-apple-system,BlinkMacSystemFont,'Helvetica Neue',sans-serif;font-style:normal;font-size:10.5px;color:#3C4043;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
        plombier carcassonne — Recherche
      </i>
    </span>
    <span style="flex:1;min-width:0;display:flex;align-items:center;gap:7px;background:#FFFFFF;border:1px solid #D2D6DB;border-radius:999px;padding:5px 11px">
      <i style="flex:none;display:block;width:7px;height:8px;border:1.4px solid #5F6368;border-radius:2px"></i>
      <i style="min-width:0;font-family:Inter,-apple-system,BlinkMacSystemFont,'Helvetica Neue',sans-serif;font-style:normal;font-size:10.5px;color:#5F6368;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
        google.com/search?q=plombier+carcassonne
      </i>
    </span>
  </div>
  <div style="background:#FFFFFF;padding:15px 18px 18px">
    <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
      <span style="flex:1 1 240px;min-width:0;display:flex;align-items:center;gap:10px;box-sizing:border-box;border:1px solid #DFE1E5;border-radius:999px;padding:8px 15px;box-shadow:0 1px 4px rgba(32,33,36,.1)">
        <i style="flex:none;display:block;width:10px;height:10px;border:1.6px solid #9AA0A6;border-radius:50%"></i>
        <i style="min-width:0;font-family:Inter,-apple-system,BlinkMacSystemFont,'Helvetica Neue',sans-serif;font-style:normal;font-size:12.5px;color:#202124">
          plombier carcassonne
        </i>
      </span>
      <span style="flex:none;display:flex;align-items:center;gap:14px">
        <span style="font-family:Inter,-apple-system,BlinkMacSystemFont,'Helvetica Neue',sans-serif;font-size:11.5px;color:#1A73E8;border-bottom:2px solid #1A73E8;padding-bottom:7px">
          Tous
        </span>
        <span style="font-family:Inter,-apple-system,BlinkMacSystemFont,'Helvetica Neue',sans-serif;font-size:11.5px;color:#5F6368;border-bottom:2px solid transparent;padding-bottom:7px">
          Maps
        </span>
        <span style="font-family:Inter,-apple-system,BlinkMacSystemFont,'Helvetica Neue',sans-serif;font-size:11.5px;color:#5F6368;border-bottom:2px solid transparent;padding-bottom:7px">
          Images
        </span>
        <span style="font-family:Inter,-apple-system,BlinkMacSystemFont,'Helvetica Neue',sans-serif;font-size:11.5px;color:#5F6368;border-bottom:2px solid transparent;padding-bottom:7px">
          Avis
        </span>
      </span>
    </div>
    <div style="margin-top:14px;display:flex;flex-direction:column;gap:4px">
      <div style="padding:9px 12px;border-radius:0;background:transparent;box-shadow:none;animation:vpRise .55s 0ms cubic-bezier(.16,1,.3,1) both">
        <div style="display:flex;align-items:center;gap:7px">
          <i style="flex:none;display:block;width:15px;height:15px;border-radius:50%;background:#DADCE0"></i>
          <i style="min-width:0;font-family:Inter,-apple-system,BlinkMacSystemFont,'Helvetica Neue',sans-serif;font-style:normal;font-size:10.5px;color:#202124;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
            concurrent-a.fr
          </i>
          <i style="flex:none;font-family:Inter,-apple-system,BlinkMacSystemFont,'Helvetica Neue',sans-serif;font-style:normal;font-size:10px;font-weight:600;color:#9AA0A6">
            #1
          </i>
        </div>
        <div style="margin-top:4px;font-family:Inter,-apple-system,BlinkMacSystemFont,'Helvetica Neue',sans-serif;font-size:14px;line-height:1.25;color:#1A0DAB;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
          Concurrent A — plomberie et chauffage à Carcassonne
        </div>
        <div style="margin-top:3px;font-family:Inter,-apple-system,BlinkMacSystemFont,'Helvetica Neue',sans-serif;font-size:11px;line-height:1.45;color:#4D5156">
          Installation et dépannage dans l’Aude depuis 1998. Devis sur demande.
        </div>
      </div>
      <div style="padding:11px 12px;border-radius:10px;background:rgba(11,47,107,.07);box-shadow:inset 0 0 0 1px rgba(11,47,107,.35);animation:vpRise .55s 120ms cubic-bezier(.16,1,.3,1) both">
        <div style="display:flex;align-items:center;gap:7px">
          <i style="flex:none;display:block;width:15px;height:15px;border-radius:50%;background:#0F172A"></i>
          <i style="min-width:0;font-family:Inter,-apple-system,BlinkMacSystemFont,'Helvetica Neue',sans-serif;font-style:normal;font-size:10.5px;color:#202124;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
            dupont-plomberie.fr
          </i>
          <i style="flex:none;font-family:Inter,-apple-system,BlinkMacSystemFont,'Helvetica Neue',sans-serif;font-style:normal;font-size:10px;font-weight:600;color:#0F172A">
            #2
          </i>
        </div>
        <div style="margin-top:4px;font-family:Inter,-apple-system,BlinkMacSystemFont,'Helvetica Neue',sans-serif;font-size:14px;line-height:1.25;color:#1A0DAB;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
          Dupont Plomberie — dépannage 24h à Carcassonne
        </div>
        <div style="margin-top:3px;font-family:Inter,-apple-system,BlinkMacSystemFont,'Helvetica Neue',sans-serif;font-size:11px;line-height:1.45;color:#4D5156">
          Fuite, chauffe-eau, climatisation. Intervention sous 24h, devis gratuit.
        </div>
        <div style="margin-top:5px;display:flex;align-items:center;gap:5px">
          <i style="font-family:Inter,-apple-system,BlinkMacSystemFont,'Helvetica Neue',sans-serif;font-style:normal;font-size:10.5px;color:#F58220;letter-spacing:.06em">
            ★★★★★
          </i>
          <i style="font-family:Inter,-apple-system,BlinkMacSystemFont,'Helvetica Neue',sans-serif;font-style:normal;font-size:10.5px;color:#4D5156">
            4,9 — 68 avis · Ouvert 24h/24
          </i>
        </div>
      </div>
      <div style="padding:9px 12px;border-radius:0;background:transparent;box-shadow:none;animation:vpRise .55s 240ms cubic-bezier(.16,1,.3,1) both">
        <div style="display:flex;align-items:center;gap:7px">
          <i style="flex:none;display:block;width:15px;height:15px;border-radius:50%;background:#DADCE0"></i>
          <i style="min-width:0;font-family:Inter,-apple-system,BlinkMacSystemFont,'Helvetica Neue',sans-serif;font-style:normal;font-size:10.5px;color:#202124;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
            annuaire-pro.fr
          </i>
          <i style="flex:none;font-family:Inter,-apple-system,BlinkMacSystemFont,'Helvetica Neue',sans-serif;font-style:normal;font-size:10px;font-weight:600;color:#9AA0A6">
            #3
          </i>
        </div>
        <div style="margin-top:4px;font-family:Inter,-apple-system,BlinkMacSystemFont,'Helvetica Neue',sans-serif;font-size:14px;line-height:1.25;color:#1A0DAB;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
          Annuaire national des artisans — plombiers (11000)
        </div>
        <div style="margin-top:3px;font-family:Inter,-apple-system,BlinkMacSystemFont,'Helvetica Neue',sans-serif;font-size:11px;line-height:1.45;color:#4D5156">
          Liste des plombiers référencés à Carcassonne et alentours.
        </div>
      </div>
    </div>
    <div style="margin-top:14px;display:flex;align-items:center;gap:10px;flex-wrap:wrap">
      <span style="font-family:Inter,-apple-system,BlinkMacSystemFont,'Helvetica Neue',sans-serif;font-size:10.5px;font-weight:600;color:#5F6368;background:#F1F3F4;border-radius:999px;padding:5px 10px">
        Avant optimisation : 9e position
      </span>
      <span style="font-family:Inter,-apple-system,BlinkMacSystemFont,'Helvetica Neue',sans-serif;font-size:10.5px;font-weight:600;color:#FFFFFF;background:#0B2F6B;border-radius:999px;padding:5px 10px">
        Après : 2e position
      </span>
    </div>
  </div>
</LaptopFrame>
