 * Utilisée sur l'accueil (onglet 01) et sur /aplomb/. États gérés par src/scripts/demos.ts
 * (data-if = écran visible, data-pressed = entrée de menu active).
 */
import LaptopFrame from './LaptopFrame.astro';
import DemoPause from './DemoPause.astro';

interface Props {
  captionColor?: string;
  /** Affiche un bouton pause à droite de la légende (page /aplomb/). */
  pause?: boolean;
}
const { captionColor = '#94A3B8', pause = false } = Astro.props;

const menu = ['Tableau de bord', 'Chantiers', 'Clients', 'Devis & factures', 'Relances', 'Compta', 'Planning équipes'];
