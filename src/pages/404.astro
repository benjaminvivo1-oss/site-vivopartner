---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionSep from '../components/SectionSep.astro';
import AuditCta from '../components/AuditCta.astro';
import { ROUTES } from '../data/site';

const links = [
  { href: ROUTES.home, label: 'Accueil' },
  { href: ROUTES.aplomb, label: 'Aplomb' },
  { href: ROUTES.ia, label: 'Réceptionniste IA' },
  { href: ROUTES.visibilite, label: 'Visibilité' },
  { href: ROUTES.faq, label: 'FAQ' },
];
---

<BaseLayout title="Page introuvable — Vivo Partner" description="Cette page n’existe pas ou a été déplacée.">
  <div style="animation:vpRise 1s cubic-bezier(.16,1,.3,1) both">
    <section style="position:relative;overflow:hidden;background:#0B2F6B;border-top:1px solid rgba(248,250,252,.12);padding:clamp(64px,8.6cqi,140px) clamp(18px,4cqi,64px)">
      <SectionSep />
      <div
        aria-hidden="true"
        style="position:absolute;inset:0;background-image:linear-gradient(rgba(248,250,252,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(248,250,252,.045) 1px,transparent 1px);background-size:64px 64px;pointer-events:none"
      ></div>
      <div class="vp-intro" style="position:relative;max-width:640px">
        <div style="font-size:11px;font-weight:500;text-transform:uppercase;letter-spacing:.13em;font-family:'JetBrains Mono',ui-monospace,monospace;color:#CBD5E1">
          Erreur 404
        </div>
        <h1 style="margin:clamp(22px,3cqi,40px) 0 0;font-family:Satoshi,Inter,sans-serif;font-weight:500;font-size:clamp(32px,5.2cqi,70px);line-height:1.03;letter-spacing:-.04em">
          Cette page <span style="color:#F58220">n’existe pas.</span>
        </h1>
        <p style="margin:clamp(20px,2.6cqi,32px) 0 0;max-width:46ch;font-size:clamp(15px,1.3cqi,17.5px);line-height:1.68;color:#CBD5E1">
          Elle a peut-être été déplacée. Les pages principales sont ci-dessous, ou réservez directement votre audit
          gratuit de 30 minutes.
        </p>
        <nav aria-label="Pages principales" style="margin-top:clamp(24px,3cqi,40px)">
          <ul style="list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:10px 22px">
            {links.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="hv-link-orange"
                  style="display:inline-block;font-size:14px;font-weight:600;color:#F8FAFC;border-bottom:1px solid rgba(248,250,252,.55);padding:4px 0 3px;transition:color .25s ease,border-color .25s ease"
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <div style="margin-top:clamp(28px,3.4cqi,44px)">
          <AuditCta />
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
