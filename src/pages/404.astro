---
/** Page 404 (non indexée), dans le style des pages légales de la maquette v3. */
import BaseLayout from '../layouts/BaseLayout.astro';

const links = [
  { href: '/', label: 'Accueil' },
  { href: '/aplomb/', label: 'Aplomb' },
  { href: '/receptionniste-ia/', label: 'Réceptionniste IA' },
  { href: '/visibilite-locale/', label: 'Visibilité' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/contact/', label: 'Contact' },
];
---

<BaseLayout title="Page introuvable | Vivo Partner" description="Cette page n’existe pas ou a été déplacée.">
  <section style="font-family:Inter,system-ui,sans-serif;color:#ffffff;box-sizing:border-box;padding:clamp(56px,6.4cqi,96px) clamp(18px,4cqi,64px);background:#06255A;border-top:1px solid rgba(248,250,252,.12);animation:vpRise 1s cubic-bezier(.16,1,.3,1) both">
    <div style="max-width:1200px;margin:0 auto;display:flex;flex-direction:column;gap:24px;align-items:flex-start">
      <span style="font-family:'JetBrains Mono',monospace;font-size:13px;letter-spacing:0.1em;text-transform:uppercase;color:#F58220;border:1px solid #B45309;border-radius:999px;padding:8px 16px">
        Erreur 404
      </span>
      <h1 style="margin:0;font-family:Satoshi,Inter,sans-serif;font-size:clamp(34px,5vw,56px);line-height:1.1;font-weight:800;letter-spacing:-0.02em">
        Cette page <span style="color:#F58220">n’existe pas.</span>
      </h1>
      <nav aria-label="Pages principales">
        <ul style="list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:10px 22px">
          {links.map((l) => (
            <li>
              <a
                href={l.href}
                class="h-5453cd"
                style="display:inline-flex;align-items:center;min-height:44px;font-size:17px;font-weight:700;color:#ffffff"
              >
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>
</BaseLayout>
