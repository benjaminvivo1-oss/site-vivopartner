---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionSep from '../components/SectionSep.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE } from '../data/site';

const direct =
  'display:block;font-family:Satoshi,sans-serif;font-weight:500;font-size:clamp(17px,1.8cqi,23px);color:#F8FAFC';
---

<BaseLayout page="contact">
  <div data-screen-label="Contact" style="animation:vpRise 1s cubic-bezier(.16,1,.3,1) both">
    <section style="position:relative;display:flex;flex-wrap:wrap;align-items:stretch;background:#0A2A5E;border-top:1px solid rgba(248,250,252,.12)">
      <SectionSep />
      <div class="vp-intro" style="flex:1 1 400px;min-width:0;padding:clamp(44px,6cqi,96px) clamp(18px,4cqi,64px)">
        <div style="font-size:11px;font-weight:500;text-transform:uppercase;letter-spacing:.13em;font-family:'JetBrains Mono',ui-monospace,monospace;color:#94A3B8">
          Contact
        </div>
        <h1 style="margin:clamp(22px,3cqi,40px) 0 0;font-family:Satoshi,Inter,sans-serif;font-weight:500;font-size:clamp(32px,5cqi,68px);line-height:1.03;letter-spacing:-.04em">
          Parlons de <span style="color:#F58220">votre entreprise.</span>
        </h1>
        <p style="margin:clamp(20px,2.6cqi,32px) 0 0;max-width:46ch;font-size:clamp(15px,1.3cqi,17.5px);line-height:1.68;color:#E2E8F0">
          Réservez un audit gratuit de 30 minutes, en visio. Aucun engagement, un diagnostic concret à la clé.
        </p>
        <div style="margin-top:clamp(28px,3.4cqi,48px);border-top:1px solid rgba(248,250,252,.22);padding-top:20px">
          <h2 style="margin:0;font-weight:400;font-size:11px;text-transform:uppercase;letter-spacing:.12em;font-family:'JetBrains Mono',ui-monospace,monospace;color:#CBD5E1">
            Ou contactez-moi directement
          </h2>
          <a href={`mailto:${SITE.email}`} class="hv-link-orange" style={`margin-top:14px;${direct}`}>
            {SITE.email}
          </a>
          <a href={SITE.phone.href} class="hv-link-orange" style={`margin-top:6px;${direct}`}>
            {SITE.phone.display}
          </a>
          <div style="margin-top:14px;font-size:13.5px;color:#CBD5E1">
            Basé à Carcassonne (Aude) — accompagnement à distance partout en France et dans les pays francophones
          </div>
        </div>
      </div>
      <div style="flex:1 1 420px;min-width:0;background:#F8FAFC;color:#0F172A;padding:clamp(32px,4cqi,64px) clamp(18px,3cqi,48px);animation:vpRiseT .9s .2s cubic-bezier(.16,1,.3,1) backwards">
        <h2 style="margin:0;font-size:11px;font-weight:500;text-transform:uppercase;letter-spacing:.13em;font-family:'JetBrains Mono',ui-monospace,monospace;color:#0B2F6B">
          Demande d’audit
        </h2>
        <ContactForm />
        <p style="margin:14px 0 0;font-size:12.5px;line-height:1.6;color:#64748B">
          <span style="color:#F58220">*</span> Champs obligatoires. Réponse sous 24h ouvrées. Vos informations servent
          uniquement à traiter votre demande.{' '}
          <a href="/confidentialite/" style="color:#F58220;cursor:pointer;border-bottom:1px solid rgba(245,130,32,.4)">
            Politique de confidentialité
          </a>
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
