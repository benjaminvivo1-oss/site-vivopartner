---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionSep from '../components/SectionSep.astro';
import UpdatedOn from '../components/UpdatedOn.astro';
import CtaBand from '../components/CtaBand.astro';
import SerpLaptop from '../components/demos/SerpLaptop.astro';
import LandingPhone from '../components/demos/LandingPhone.astro';

// Suivi mensuel d'exemple : position avant → après.
const queries = [
  { q: 'plombier carcassonne', from: '#9', to: '#2' },
  { q: 'dépannage fuite urgence', from: '#14', to: '#3' },
  { q: 'installation climatisation aude', from: '#22', to: '#5' },
  { q: 'chauffagiste rge carcassonne', from: '#31', to: '#7' },
];

const bricks = [
  {
    title: 'Site internet',
    text: 'Création one-shot, pensée pour convertir un visiteur en demande de devis.',
    tilt: '-1.4deg',
  },
  {
    title: 'SEO / GEO',
    text: 'Référencement local et dans les intelligences artificielles, optimisation et suivi mensuel, pour apparaître quand vos clients vous cherchent.',
    tilt: '1.1deg',
  },
  {
    title: 'Google My Business',
    text: 'Optimisation de votre fiche pour apparaître dans les recherches locales et sur Google Maps.',
    tilt: '-.7deg',
  },
  {
    title: 'Publicités',
    text: 'Gestion de campagnes Meta/Google Ads, budget publicitaire séparé de la gestion.',
    tilt: '1.5deg',
  },
];
const mono = "font-family:'JetBrains Mono',ui-monospace,monospace";
---

<BaseLayout page="visibilite">
  <div data-screen-label="Visibilité" style="animation:vpRise 1s cubic-bezier(.16,1,.3,1) both">
    <section
      class="vp-intro"
      style="position:relative;background:#0A2A5E;padding:clamp(64px,8.6cqi,140px) clamp(18px,4cqi,64px);border-top:1px solid rgba(248,250,252,.12)"
    >
      <SectionSep />
      <div style="font-size:11px;font-weight:500;text-transform:uppercase;letter-spacing:.13em;font-family:'JetBrains Mono',ui-monospace,monospace;color:#94A3B8">
        Levier 03 — Visibilité
      </div>
      <h1 style="margin:clamp(22px,3cqi,40px) 0 0;font-family:Satoshi,Inter,sans-serif;font-weight:500;font-size:clamp(34px,5.6cqi,76px);line-height:1.02;letter-spacing:-.04em">
        Être trouvé, <span style="color:#F58220">avant d’être choisi.</span>
      </h1>
      <p style="margin:clamp(20px,2.6cqi,32px) 0 0;max-width:60ch;font-size:clamp(15px,1.3cqi,17.5px);line-height:1.68;color:#E2E8F0">
        Un client potentiel qui ne vous trouve pas ne peut pas vous demander de devis. La visibilité regroupe quatre
        leviers indépendants, à combiner selon vos besoins. Site internet, référencement local et IA, fiche Google et
        publicité : Vivo Partner accompagne les entreprises du BTP à Carcassonne et partout en France, à partir d’un
        audit gratuit de 30 minutes.
      </p>
      <UpdatedOn page="visibilite" />
    </section>

    <section
      data-screen-label="Visibilité — démo"
      data-vp-inview
      style="position:relative;overflow:hidden;background:#0B2F6B;border-top:1px solid rgba(248,250,252,.12);padding:clamp(64px,8.6cqi,140px) clamp(18px,4cqi,64px)"
    >
      <SectionSep />
      <div
        aria-hidden="true"
        style="position:absolute;inset:0;background-image:linear-gradient(rgba(245,130,32,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(245,130,32,.055) 1px,transparent 1px);background-size:64px 64px;pointer-events:none"
      ></div>
      <div style="position:relative">
        <div style="display:flex;gap:clamp(20px,4cqi,64px);flex-wrap:wrap;align-items:flex-end">
          <div data-vp-reveal="0" style="flex:1 1 400px;min-width:0">
            <span style={`${mono};font-size:11px;text-transform:uppercase;letter-spacing:.13em;color:#94A3B8`}>
              La démo
            </span>
            <h2 style="margin:14px 0 0;max-width:28ch;font-family:Satoshi,Inter,sans-serif;font-weight:500;font-size:clamp(24px,3.2cqi,42px);line-height:1.08;letter-spacing:-.04em;text-wrap:pretty">
              De la 9e à la 2e place, puis en demande de devis
            </h2>
          </div>
          <p data-vp-reveal="1" style="margin:0;flex:0 1 300px;font-size:14px;line-height:1.6;color:#94A3B8">
            Position sur les requêtes locales, suivi mensuel, et la page qui transforme la visite en demande.
          </p>
        </div>
        <div data-vp-reveal="2" style="margin-top:clamp(26px,3.4cqi,44px)">
          <div style="display:flex;flex-direction:column;gap:clamp(24px,3cqi,40px)">
            <div style="min-width:0">
              <SerpLaptop />
              <div style="margin-top:26px">
                <div
                  style={`${mono};font-size:10px;text-transform:uppercase;letter-spacing:.13em;color:#94A3B8;margin-bottom:6px`}
                >
                  Suivi mensuel des requêtes
                </div>
                {queries.map((r, i) => (
                  <div
                    style={`display:flex;align-items:center;gap:12px;padding:11px 0;border-bottom:1px solid rgba(248,250,252,.09);animation:vpRise .55s ${i * 120}ms cubic-bezier(.16,1,.3,1) both`}
                  >
                    <span style="flex:1 1 150px;min-width:0;font-size:13px;color:#E2E8F0">{r.q}</span>
                    <span style={`flex:none;${mono};font-size:11.5px;color:#94A3B8`}>{r.from}</span>
                    <span style={`flex:none;${mono};font-size:11px;color:#94A3B8`}>→</span>
                    <span style={`flex:none;${mono};font-size:11.5px;color:#F58220`}>{r.to}</span>
                  </div>
                ))}
              </div>
              <p
                style={`margin:18px 0 0;${mono};font-size:10.5px;text-transform:uppercase;letter-spacing:.1em;color:#94A3B8`}
              >
                Positions d’exemple — mesurées à l’audit
              </p>
            </div>
            <div style="display:flex;gap:clamp(18px,2.6cqi,36px);flex-wrap:wrap;align-items:center">
              <LandingPhone />
              <p style="margin:0;flex:1 1 240px;min-width:0;max-width:44ch;font-size:14px;line-height:1.65;color:#94A3B8">
                Une page par métier et par ville, tournée vers une seule action : la demande de devis.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section style="position:relative;background:#0A2A5E;border-top:1px solid rgba(248,250,252,.12);padding:clamp(64px,8.6cqi,140px) clamp(18px,4cqi,64px)">
      <SectionSep />
      <div style="display:flex;gap:24px;flex-wrap:wrap;align-items:flex-end;justify-content:space-between">
        <h2
          data-vp-reveal="0"
          style="margin:0;font-family:Satoshi,Inter,sans-serif;font-weight:500;font-size:clamp(24px,3cqi,40px);line-height:1.1;letter-spacing:-.04em"
        >
          Les 4 briques, à la carte
        </h2>
        <p data-vp-reveal="1" style="margin:0;max-width:44ch;font-size:14.5px;line-height:1.6;color:#94A3B8">
          Chaque brique se prend seule ou combinée. Le site n’oblige pas au SEO, le SEO n’oblige pas à la pub.
        </p>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,max(240px,calc(50% - 26px))),1fr));gap:30px 26px;padding-top:10px;margin-top:clamp(28px,3.4cqi,48px)">
        {bricks.map((b, i) => (
          <div
            class="hv-straighten vp-paper"
            data-vp-reveal
            style={`position:relative;box-sizing:border-box;background:#F8FAFC;color:#0F172A;border-radius:3px;padding:clamp(26px,2.8cqi,36px) clamp(22px,2.6cqi,32px);box-shadow:0 16px 32px rgba(2,8,22,.35);transform:rotate(${b.tilt});transition:transform .35s cubic-bezier(.16,1,.3,1);--vp-settle:${b.tilt.startsWith('-') ? '-1.2deg' : '1.2deg'}`}
          >
            <span
              aria-hidden="true"
              style={`position:absolute;top:-8px;left:50%;width:60px;height:15px;margin-left:-30px;background:rgba(245,130,32,.85);transform:rotate(${i % 2 ? '-2deg' : '2deg'})`}
            />
            <span style={`${mono};font-weight:700;font-size:26px;color:transparent;-webkit-text-stroke:1px #F58220`}>
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 style="margin:clamp(24px,3cqi,44px) 0 0;font-family:Satoshi,sans-serif;font-weight:500;font-size:clamp(18px,1.8cqi,24px);color:#0B2F6B">
              {b.title}
            </h3>
            <p style="margin:10px 0 0;font-size:14.5px;line-height:1.62;color:#475569">{b.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section style="position:relative;background:#0B2F6B;color:#F8FAFC;border-top:1px solid rgba(248,250,252,.12);padding:clamp(52px,6.6cqi,108px) clamp(18px,4cqi,64px)">
      <SectionSep />
      <div data-vp-reveal="0" style="display:flex;gap:clamp(24px,4cqi,64px);flex-wrap:wrap;align-items:center">
        <div
          class="hv-straighten vp-paper"
          style="flex:0 1 auto;position:relative;box-sizing:border-box;background:#F8FAFC;color:#0F172A;border-radius:3px;padding:30px 30px 26px;box-shadow:0 16px 32px rgba(2,8,22,.35);transform:rotate(1.5deg);transition:transform .35s cubic-bezier(.16,1,.3,1);--vp-settle:1.4deg"
        >
          <span
            aria-hidden="true"
            style="position:absolute;top:-8px;left:50%;width:60px;height:15px;margin-left:-30px;background:rgba(245,130,32,.85);transform:rotate(2deg)"
          ></span>
          <div
            style={`font-size:11px;font-weight:500;text-transform:uppercase;letter-spacing:.13em;${mono};color:#64748B`}
          >
            Résultats attendus
          </div>
          <div
            style={`margin-top:12px;${mono};font-weight:700;font-size:clamp(38px,5.6cqi,76px);line-height:.9;letter-spacing:-.04em;color:#0B2F6B`}
          >
            +<span data-vp-count="50">50</span>%
          </div>
        </div>
        <p style="margin:0;flex:1 1 280px;min-width:0;max-width:40ch;font-size:16px;line-height:1.65;color:#CBD5E1">
          Augmente de 50% les demandes de devis générées.
        </p>
      </div>
    </section>

    <CtaBand maxWidth="24ch">Faire le point sur ma visibilité en ligne</CtaBand>
  </div>
</BaseLayout>
