---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionSep from '../components/SectionSep.astro';
import UpdatedOn from '../components/UpdatedOn.astro';
import CtaBand from '../components/CtaBand.astro';
import AplombDemo from '../components/demos/AplombDemo.astro';

const modules = [
  { text: 'Création de devis et factures automatisée', tilt: '-1.4deg' },
  { text: 'Relances automatiques (devis en attente, factures impayées)', tilt: '1.1deg' },
  { text: 'Suivi de chantier poussé', tilt: '-.7deg' },
  { text: 'CRM clients', tilt: '1.5deg' },
  { text: 'Compta et administratif simplifiés', tilt: '-1.2deg' },
  { text: 'Tableau de bord de votre chiffre d’affaires', tilt: '.9deg' },
  {
    text: 'Et bien d’autres modules selon votre métier (avis Google automatiques, planning équipes, marge par chantier, contrats d’entretien...)',
    tilt: '-1.4deg',
  },
  { text: 'Possibilité de créer un module sur mesure, spécialement conçu pour vos besoins précis', tilt: '1.1deg' },
];
---

<BaseLayout page="aplomb">
  <div data-screen-label="Aplomb" style="animation:vpRise 1s cubic-bezier(.16,1,.3,1) both">
    <section
      class="vp-intro"
      style="position:relative;background:#0B2F6B;padding:clamp(64px,8.6cqi,140px) clamp(18px,4cqi,64px);border-top:1px solid rgba(248,250,252,.12)"
    >
      <SectionSep />
      <div style="font-size:11px;font-weight:500;text-transform:uppercase;letter-spacing:.13em;font-family:'JetBrains Mono',ui-monospace,monospace;color:#94A3B8">
        Levier 01 — Aplomb
      </div>
      <h1 style="margin:clamp(22px,3cqi,40px) 0 0;max-width:22ch;font-family:Satoshi,Inter,sans-serif;font-weight:500;font-size:clamp(32px,5.2cqi,70px);line-height:1.03;letter-spacing:-.04em">
        Votre entreprise a ses propres process. <span style="color:#F58220">Votre outil aussi.</span>
      </h1>
      <p style="margin:clamp(20px,2.6cqi,32px) 0 0;max-width:62ch;font-size:clamp(15px,1.3cqi,17.5px);line-height:1.68;color:#E2E8F0">
        Aplomb n’est pas un logiciel BTP de plus où vous devez vous adapter à lui — c’est une application construite
        pour votre entreprise, autour de vos process, vos équipes et vos outils. Vivo Partner la conçoit depuis
        Carcassonne pour les entreprises du BTP de toute la France ; tout commence par un audit gratuit de 30 minutes en
        visio.
      </p>
      <UpdatedOn page="aplomb" />
    </section>

    <section
      data-screen-label="Aplomb — démo"
      data-demos
      data-vp-inview
      style="position:relative;overflow:hidden;background:#0A2A5E;border-top:1px solid rgba(248,250,252,.12);padding:clamp(64px,8.6cqi,140px) clamp(18px,4cqi,64px)"
    >
      <SectionSep />
      <div
        aria-hidden="true"
        style="position:absolute;inset:0;background-image:linear-gradient(rgba(245,130,32,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(245,130,32,.055) 1px,transparent 1px);background-size:64px 64px;pointer-events:none"
      ></div>
      <div style="position:relative">
        <div style="display:flex;gap:clamp(20px,4cqi,64px);flex-wrap:wrap;align-items:flex-end">
          <div data-vp-reveal="0" style="flex:1 1 400px;min-width:0">
            <span style="font-family:'JetBrains Mono',ui-monospace,monospace;font-size:11px;text-transform:uppercase;letter-spacing:.13em;color:#94A3B8">
              La démo
            </span>
            <h2 style="margin:14px 0 0;max-width:28ch;font-family:Satoshi,Inter,sans-serif;font-weight:500;font-size:clamp(24px,3.2cqi,42px);line-height:1.08;letter-spacing:-.04em;text-wrap:pretty">
              L’application, module par module
            </h2>
          </div>
          <p data-vp-reveal="1" style="margin:0;flex:0 1 300px;font-size:14px;line-height:1.6;color:#94A3B8">
            Cliquez un module pour l’ouvrir. L’aperçu défile seul tant que vous ne prenez pas la main ; les colonnes et
            indicateurs sont définis avec vous après l’audit.
          </p>
        </div>
        <div data-vp-reveal="2" style="margin-top:clamp(26px,3.4cqi,44px)">
          <div style="display:flex;flex-direction:column;gap:clamp(22px,2.6cqi,36px)">
            <div style="min-width:0">
              <AplombDemo captionColor="#94A3B8" pause />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section style="position:relative;background:#0B2F6B;border-top:1px solid rgba(248,250,252,.12);padding:clamp(64px,8.6cqi,140px) clamp(18px,4cqi,64px)">
      <SectionSep />
      <div style="display:flex;gap:clamp(24px,4cqi,72px);flex-wrap:wrap;align-items:flex-start">
        <div data-vp-reveal="0" style="flex:1 1 300px;min-width:0">
          <h2 style="margin:0;font-family:Satoshi,Inter,sans-serif;font-weight:500;font-size:clamp(24px,3cqi,40px);line-height:1.1;letter-spacing:-.04em">
            Ce qu’Aplomb gère au quotidien
          </h2>
          <p style="margin:16px 0 0;max-width:40ch;font-size:15.5px;line-height:1.65;color:#CBD5E1">
            Aplomb propose un vaste catalogue de modules :
          </p>
          <div style="margin-top:28px;border-top:1px solid rgba(248,250,252,.08);padding-top:20px">
            <div style="font-size:11px;text-transform:uppercase;letter-spacing:.12em;font-family:'JetBrains Mono',ui-monospace,monospace;color:#94A3B8">
              Construit sur mesure
            </div>
            <p style="margin:10px 0 0;max-width:42ch;font-size:15px;line-height:1.65;color:#E2E8F0">
              Chaque Aplomb est configuré selon votre activité réelle. Une entreprise de plomberie n’a pas les mêmes
              besoins qu’une entreprise de terrassement — votre application non plus.
            </p>
          </div>
        </div>
        <ul style="list-style:none;margin:0;flex:1 1 380px;min-width:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr));gap:26px 22px;padding:10px 0 0">
          {modules.map((m, i) => (
            <li
              class="hv-straighten vp-paper"
              data-vp-reveal
              style={`position:relative;box-sizing:border-box;background:#F8FAFC;color:#0F172A;border-radius:3px;padding:24px 20px 18px;box-shadow:0 16px 32px rgba(2,8,22,.35);transform:rotate(${m.tilt});transition:transform .35s cubic-bezier(.16,1,.3,1);--vp-settle:${m.tilt.startsWith('-') ? '-1.2deg' : '1.2deg'}`}
            >
              <span
                aria-hidden="true"
                style={`position:absolute;top:-8px;left:50%;width:60px;height:15px;margin-left:-30px;background:rgba(245,130,32,.85);transform:rotate(${i % 2 ? '-2deg' : '2deg'})`}
              />
              <span style="font-family:'JetBrains Mono',ui-monospace,monospace;font-size:11px;color:#B45309">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div style="margin-top:8px;font-size:15px;line-height:1.5;color:#0B2F6B;font-weight:500">{m.text}</div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section style="position:relative;background:#0A2A5E;color:#F8FAFC;border-top:1px solid rgba(248,250,252,.12);padding:clamp(52px,6.6cqi,108px) clamp(18px,4cqi,64px)">
      <SectionSep />
      <div data-vp-reveal="0" style="display:flex;gap:clamp(24px,4cqi,64px);flex-wrap:wrap;align-items:center">
        <div
          class="hv-straighten vp-paper"
          style="flex:0 1 auto;position:relative;box-sizing:border-box;background:#F8FAFC;color:#0F172A;border-radius:3px;padding:30px 30px 26px;box-shadow:0 16px 32px rgba(2,8,22,.35);transform:rotate(1.1deg);transition:transform .35s cubic-bezier(.16,1,.3,1);--vp-settle:1.4deg"
        >
          <span
            aria-hidden="true"
            style="position:absolute;top:-8px;left:50%;width:60px;height:15px;margin-left:-30px;background:rgba(245,130,32,.85);transform:rotate(2deg)"
          ></span>
          <div style="font-size:11px;font-weight:500;text-transform:uppercase;letter-spacing:.13em;font-family:'JetBrains Mono',ui-monospace,monospace;color:#64748B">
            Résultats attendus
          </div>
          <div style="margin-top:12px;font-family:'JetBrains Mono',ui-monospace,monospace;font-weight:700;font-size:clamp(38px,5.6cqi,76px);line-height:.9;letter-spacing:-.04em;color:#0B2F6B">
            ≈<span data-vp-count="5">5</span>h
            <span style="font-size:.34em;font-weight:500;letter-spacing:0;color:#64748B"> / semaine</span>
          </div>
        </div>
        <p style="margin:0;flex:1 1 280px;min-width:0;max-width:40ch;font-size:16px;line-height:1.65;color:#CBD5E1">
          Environ 5h gagnées par semaine sur l’administratif (devis, relances, suivi).
        </p>
      </div>
    </section>

    <CtaBand>Voir comment Aplomb s’adapterait à mon entreprise</CtaBand>
  </div>
</BaseLayout>
