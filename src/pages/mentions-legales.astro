---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionSep from '../components/SectionSep.astro';
import { SITE } from '../data/site';

const h2 = 'font-family:Satoshi,sans-serif;font-weight:500;font-size:clamp(17px,1.7cqi,21px);color:#F8FAFC';
const para = 'font-size:15px;line-height:1.72;color:#CBD5E1';
---

<BaseLayout page="legal">
  <div data-screen-label="Mentions légales" style="animation:vpRise 1s cubic-bezier(.16,1,.3,1) both">
    <section
      class="vp-intro"
      style="position:relative;background:#0B2F6B;color:#F8FAFC;border-top:1px solid rgba(248,250,252,.12);padding:clamp(44px,6cqi,92px) clamp(18px,4cqi,64px) clamp(52px,7cqi,112px)"
    >
      <SectionSep />
      <div style="font-size:11px;font-weight:500;text-transform:uppercase;letter-spacing:.13em;font-family:'JetBrains Mono',ui-monospace,monospace;color:#CBD5E1">
        Informations légales
      </div>
      <h1 style="margin:clamp(18px,2.4cqi,32px) 0 0;font-family:Satoshi,Inter,sans-serif;font-weight:500;font-size:clamp(28px,3.8cqi,50px);line-height:1.06;letter-spacing:-.04em">
        Mentions légales
      </h1>
      <div
        aria-hidden="true"
        style="height:12px;margin:clamp(26px,3cqi,42px) 0 0;background:repeating-linear-gradient(90deg,rgba(248,250,252,.35) 0 1px,transparent 1px 11px);border-bottom:1px solid rgba(248,250,252,.16)"
      ></div>
      <div style="display:flex;gap:clamp(24px,4cqi,72px);flex-wrap:wrap;margin-top:clamp(28px,3.4cqi,48px)">
        <div style="flex:1 1 300px;min-width:0;max-width:44ch">
          <h2 style={`margin:0;${h2}`}>Éditeur du site</h2>
          <div style="margin-top:14px;display:flex;flex-direction:column;gap:7px;font-size:15px;line-height:1.5;color:#CBD5E1">
            <span style="color:#F8FAFC;font-weight:500">
              {SITE.name} — {SITE.founder}
            </span>
            <span>Auto-entrepreneur (micro-entreprise)</span>
            <span>SIRET : {SITE.siret}</span>
            <span>Localisation : {SITE.city}, France</span>
            <span>
              Email : <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
            </span>
            <span>
              Téléphone : <a href={SITE.phone.href}>{SITE.phone.display}</a>
            </span>
          </div>
          <h2 style={`margin:34px 0 0;${h2}`}>Hébergement</h2>
          <div style="margin-top:14px;display:flex;flex-direction:column;gap:7px;font-size:15px;line-height:1.5;color:#CBD5E1">
            <span style="color:#F8FAFC;font-weight:500">Vercel Inc.</span>
            <span>440 N Barranca Ave #4133, Covina, CA 91723, États-Unis</span>
            <span>Téléphone : +1 559 288 7060</span>
            <span>
              Site : <a href="https://vercel.com">vercel.com</a>
            </span>
          </div>
          <h2 style={`margin:34px 0 0;${h2}`}>Propriété intellectuelle</h2>
          <p style="margin:12px 0 0;font-size:15px;line-height:1.7;color:#CBD5E1">
            L’ensemble des contenus présents sur ce site (textes, visuels, logo) est la propriété de Vivo Partner, sauf
            mention contraire.
          </p>
        </div>
        <div style="flex:1 1 380px;min-width:0;max-width:62ch;border-left:1px solid rgba(248,250,252,.16);padding-left:clamp(20px,3cqi,44px)">
          <h2 style={`margin:0;${h2}`}>Données personnelles</h2>
          <p style={`margin:14px 0 0;${para}`}>
            Les informations recueillies via le formulaire de contact (nom, entreprise, secteur d’activité, téléphone,
            email, message) sont utilisées exclusivement pour traiter votre demande et vous recontacter dans le cadre de
            l’audit ou de nos échanges commerciaux. Elles ne sont ni revendues ni transmises à des tiers en dehors des
            outils nécessaires au fonctionnement du site et de la relation client.
          </p>
          <p style={`margin:18px 0 0;${para}`}>
            Conformément au Règlement Général sur la Protection des Données (RGPD), vous disposez d’un droit d’accès, de
            rectification et de suppression de vos données personnelles. Pour exercer ce droit, contactez-nous à
            l’adresse <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
          </p>
          <p style={`margin:18px 0 0;${para}`}>
            Les données sont conservées pendant la durée nécessaire au traitement de votre demande, puis supprimées ou
            archivées conformément aux obligations légales.
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
